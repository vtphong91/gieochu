// Gieo Chữ — Prisma schema
// Grows module by module per docs/GIEOCHU_PROMPT_MVP_PHASE1.md §10.
// M0: only the models needed to seed a working foundation (system admin,
// sample plans, CMS home page). M1 adds UserProfile/RefreshToken/
// VerificationToken; later modules add the tenant/product/order graph.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: connection URLs live in prisma.config.ts (CLI/migrate uses
// DIRECT_URL), not here. The app's runtime PrismaClient gets its own adapter
// built from DATABASE_URL in src/client.ts — see docs/DECISIONS.md ADR-003.
datasource db {
  provider = "postgresql"
}

enum SystemRole {
  USER
  SYSTEM_ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  LOCKED
}

/// §5.1 Layer System — USERS
model User {
  id                    String     @id @default(cuid(2))
  email                 String     @unique
  passwordHash          String
  systemRole            SystemRole @default(USER)
  status                UserStatus @default(PENDING)
  /// §"M2": only the seeded super admin can be granted/locked with no further
  /// checks bypassed — the *one* admin nobody (incl. other admins) can lock.
  isSuperAdmin          Boolean    @default(false)
  emailVerifiedAt       DateTime?
  profileCompletedAt    DateTime?
  lastLoginAt           DateTime?
  /// Đếm liên tiếp số lần sai mật khẩu (chỉ khi email có thật — xem
  /// apps/web/app/api/auth/login/route.ts). Về 0 khi đăng nhập thành công
  /// hoặc khi đặt lại mật khẩu thành công. Đạt 5 -> `passwordResetRequired`.
  failedLoginAttempts   Int        @default(0)
  /// True khi `failedLoginAttempts` chạm ngưỡng — chặn đăng nhập (kể cả đúng
  /// mật khẩu) cho tới khi đặt lại mật khẩu qua /forgot-password, KHÔNG liên
  /// quan `status` (đó là khoá admin/email-chưa-xác-minh, khác concern).
  passwordResetRequired Boolean    @default(false)
  /// ADR-061 Q1: false = tài khoản tạo từ "mua không cần đăng ký" (khách vãng lai), chưa tự đặt mật khẩu — `passwordHash` là
  /// hash của chuỗi ngẫu nhiên không ai biết (không NULL để code cũ không vỡ). Thành true khi khách đặt mật khẩu qua email
  /// "Kích hoạt tài khoản và đặt mật khẩu". Tài khoản có sẵn: true (DEFAULT).
  hasPassword           Boolean    @default(true)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  profile              UserProfile?
  refreshTokens        RefreshToken[]
  verificationTokens   VerificationToken[]
  ownedTenant          Tenant?
  tenantMemberships    TenantMember[]
  orders               Order[]
  entitlements         Entitlement[]
  tenantCustomerOf     TenantCustomer[]
  downloadTokens       DownloadToken[]
  downloadEvents       DownloadEvent[]
  reviews              Review[]
  abuseReportsFiled    AbuseReport[]         @relation("AbuseReportReporter")
  abuseReportsResolved AbuseReport[]         @relation("AbuseReportResolver")
  orderNotesAuthored   OrderNote[]           @relation("OrderNoteAuthor")
  legalAcceptances     UserLegalAcceptance[]
  tenantEditorDrafts   TenantEditorDraft[]
  systemEditorDrafts   SystemEditorDraft[]

  @@map("users")
}

/// §5.1 Layer System — USER_PROFILES. Created at registration with just
/// fullName + consentAt; phone/province tự nguyện điền sau qua /account/profile
/// (không còn là cổng bắt buộc trước khi dùng hệ thống — xem
/// packages/auth/src/profile.ts isProfileComplete()). `occupation` không còn
/// dùng (từng trùng lựa chọn loại tài khoản lúc đăng ký) — giữ cột nullable,
/// không migrate xoá.
model UserProfile {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  phone      String?
  avatarKey  String?
  occupation String?
  province   String?
  consentAt  DateTime

  @@map("user_profiles")
}

/// §5.1 Layer System — REFRESH_TOKENS (rotated on every use; reuse of a
/// replaced token revokes the whole familyId — see M1 sequence diagram).
/// ADR-053: một familyId = một phiên đăng nhập (một thiết bị). rememberMe/sessionStartedAt/userAgent/ip/deviceLabel
/// chép nguyên sang token mới mỗi lần rotate. "Hoạt động gần nhất" của phiên = createdAt của token còn hiệu lực
/// (rotate chỉ xảy ra khi người dùng có thao tác) — không cần cột lastUsedAt. sessionStartedAt NULL = phiên tạo trước
/// ADR-053 (code coi như bắt đầu từ lần rotate đầu tiên sau deploy).
model RefreshToken {
  id               String    @id @default(cuid(2))
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId         String
  tokenHash        String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedById     String?
  userAgent        String?
  ip               String?
  /// ADR-053: true = cookie refresh persistent tới hết absolute (rememberMeDays); false = session cookie. SYSTEM_ADMIN luôn false.
  rememberMe       Boolean   @default(false)
  /// ADR-053: thời điểm đăng nhập của phiên (không trượt khi rotate) — mốc tính absolute timeout.
  sessionStartedAt DateTime?
  /// ADR-053: nhãn thiết bị đã parse từ User-Agent ở server (vd "Chrome · Windows") cho danh sách thiết bị.
  deviceLabel      String?
  /// ADR-061 Q1: phiên cấp ngay khi khách vãng lai tạo tài khoản ở trang thanh toán (user còn PENDING). Chỉ phiên có cờ này
  /// được refresh khi user chưa xác minh email, và chỉ vào được các trang mua/xem đơn/tải (`requireCheckoutAccess`).
  guestCheckout    Boolean   @default(false)
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  /// ADR-053: cron dọn bản ghi hết hạn/đã thu hồi quá 90 ngày.
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}

enum VerificationTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  /// ADR-041: đổi email đăng nhập — link gửi tới email MỚI (`newEmail`), xác nhận được khi chưa đăng nhập.
  EMAIL_CHANGE
  /// ADR-061 Q1: "Kích hoạt tài khoản và đặt mật khẩu" cho khách vãng lai — một lần dùng: xác minh email + đặt mật khẩu.
  GUEST_ACTIVATION
}

/// §5.1 Layer System — VERIFICATION_TOKENS (email activation + password reset)
model VerificationToken {
  id        String                @id @default(cuid(2))
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      VerificationTokenType
  tokenHash String                @unique
  /// ADR-041: email đích (đã chuẩn hoá) — chỉ có giá trị với type = EMAIL_CHANGE. Dữ liệu cá nhân.
  newEmail  String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  @@index([userId, type])
  @@map("verification_tokens")
}

enum PlanInterval {
  MONTH
  YEAR
}

/// §5.1 Layer System — PLANS (subscription plans System admin manages)
/// §"M3 v2" ADR-021: `isFree` marks the plan `createTenantForUser()` assigns
/// to every new tenant and that `subscription-sweep.ts` excludes from
/// GRACE/EXPIRED sweeping and downgrades a lapsed paid subscription back to.
/// `features` are boolean entitlement flags (see
/// `packages/core/src/billing/feature-gate.ts`) — business logic reads
/// these, never `plan.code`, so plan packaging stays a pure commercial
/// concern editable from System Admin.
model Plan {
  id             String       @id @default(cuid(2))
  code           String       @unique
  name           String
  priceVnd       Int
  interval       PlanInterval
  intervalCount  Int          @default(1)
  maxProducts    Int
  storageMb      Int
  maxFileMb      Int
  /// ADR-028: hạn mức ảnh Cloudinary (MB) — cộng chung ảnh mô tả + ảnh bìa + ảnh storefront (`tenant_media_assets`).
  /// Default 100 = mức FREE, an toàn cho gói tạo mới chưa đặt số.
  imageStorageMb Int          @default(100)
  isFree         Boolean      @default(false)
  features       Json         @default("{}")
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  subscriptions Subscription[]
  invoices      SubscriptionInvoice[]

  @@map("plans")
}

enum RoleScope {
  SYSTEM
  TENANT
}

/// L1 — nguồn sự thật cho "tier này được làm gì", thay các hàm hardcode TS
/// (`canManageTenant()`...). Role là định nghĩa toàn cục (không phải row
/// theo từng tenant) — mọi OWNER/STAFF của mọi tenant cùng trỏ về 1 Role qua
/// `code`, đối chiếu với `User.systemRole` / `TenantMember.role` (giữ
/// nguyên làm nhãn định danh, không đổi thành FK — xem ADR-022) lúc đọc.
/// `code` khớp enum theo quy ước seed: SYSTEM_ADMIN, TENANT_OWNER,
/// TENANT_STAFF.
model Role {
  id          String    @id @default(cuid(2))
  code        String    @unique
  scope       RoleScope
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  permissions RolePermission[]

  @@map("roles")
}

/// 1 row / hành động có thể cấp quyền, namespace kiểu "system:manage_users",
/// "tenant:manage_products".
model Permission {
  id          String   @id @default(cuid(2))
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum CmsPageStatus {
  DRAFT
  PUBLISHED
}

/// §5.1 Layer System — cms_pages (marketing content blocks)
/// `blocks` là bản LIVE (đang hiển thị công khai). `blocksDraft` là bản đang
/// sửa dở — null nghĩa là chưa có nháp nào khác bản live. Lưu nháp chỉ ghi
/// `blocksDraft`, không đụng `blocks`; Publish copy blocksDraft -> blocks rồi
/// xoá blocksDraft; "Khôi phục live" xoá blocksDraft để quay lại đúng bản live.
model CmsPage {
  id             String        @id @default(cuid(2))
  slug           String        @unique
  title          String
  blocks         Json
  blocksDraft    Json?
  status         CmsPageStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("cms_pages")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE
  EXPIRED
  CANCELED
}

/// §5.1 Layer System — SUBSCRIPTIONS. M4 onboarding opens the TRIALING row;
/// §"M3" adds invoices, the sweep job (subscription.sweep), and the rest of
/// the state machine (packages/core/src/billing/subscription-state.ts).
/// PAST_DUE is declared on SubscriptionStatus but never assigned by M3's
/// state machine (only TRIALING/ACTIVE/GRACE/EXPIRED/CANCELED per the
/// mermaid diagram in the spec) — same "declared, unused" pattern as
/// PlatformInvoiceStatus.VOID in the TaniGos report used to design this
/// module; left in place rather than removed in case a later phase needs it.
model Subscription {
  id                     String             @id @default(cuid(2))
  tenantId               String             @unique
  tenant                 Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId                 String
  plan                   Plan               @relation(fields: [planId], references: [id])
  status                 SubscriptionStatus @default(TRIALING)
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  graceEndsAt            DateTime?
  /// Which pre-expiry reminder (7 or 1 day) was last sent for the CURRENT
  /// period — null means none yet. Reset to null on every period renewal
  /// (subscription-billing.ts markInvoicePaid) and on entering GRACE, so a
  /// later period's reminders always start fresh instead of skipping.
  periodEndReminderStage Int?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@map("subscriptions")
}

enum TenantStatus {
  ACTIVE
  READ_ONLY
  LOCKED
}

/// §5.2 Layer Tenant — TENANTS. Each row is an L2 root; tenant-scoped child
/// tables (tenant_members, products, ...) carry tenant_id and are protected
/// by RLS policies (packages/db/prisma/migrations/*_rls_m4/) enforced
/// through withTenant/withPublic/withCustomer/withSystemJob (packages/db/src/rls.ts).
model Tenant {
  id                      String       @id @default(cuid(2))
  slug                    String       @unique
  ownerId                 String       @unique
  owner                   User         @relation(fields: [ownerId], references: [id])
  name                    String
  bio                     String?
  logoKey                 String?
  coverKey                String?
  /// { primaryColor, accentColor, socialLinks: { facebook?, youtube?, tiktok?, zalo?, website? } }
  branding                Json?
  /// ADR-023: storefront sections đã xuất bản (validate bằng `storefrontSectionsSchema`, @gieochu/core). null = chưa từng xuất bản → nội dung demo sinh trong code.
  storefrontSections      Json?
  /// ADR-023: bản nháp đang soạn trong Studio; null = không có nháp.
  storefrontSectionsDraft Json?
  orderCodePrefix         String       @unique
  status                  TenantStatus @default(ACTIVE)
  storageUsedBytes        Int          @default(0)
  storageBucket           String?
  storageProvider         String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  members              TenantMember[]
  slugHistory          TenantSlugHistory[]
  subscription         Subscription?
  products             Product[]
  paymentConfigs       TenantPaymentConfig[]
  subscriptionInvoices SubscriptionInvoice[]
  coupons              Coupon[]
  orders               Order[]
  transactions         TenantPaymentTransaction[]
  customers            TenantCustomer[]
  entitlements         Entitlement[]
  shareLinks           ShareLink[]
  downloadEvents       DownloadEvent[]
  storefrontMessages   StorefrontMessage[]
  mediaAssets          TenantMediaAsset[]
  reviews              Review[]
  posts                Post[]
  dailyStats           TenantDailyStat[]
  abuseReports         AbuseReport[]
  subscriptionRefund   SubscriptionRefundRequest?
  orderNotes           OrderNote[]
  editorDrafts         TenantEditorDraft[]

  @@map("tenants")
}

enum TenantMemberRole {
  OWNER
  STAFF
}

/// §5.2 — TENANT_MEMBERS. MVP only ever creates OWNER rows (§2.2: staff with
/// fine-grained permissions is out of scope, schema is ready for later).
model TenantMember {
  tenantId String
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     TenantMemberRole @default(OWNER)
  joinedAt DateTime         @default(now())

  @@id([tenantId, userId])
  @@index([tenantId])
  @@map("tenant_members")
}

/// §4.3 — used to 301-redirect an old slug (changed at most once/30 days) to
/// the tenant's current one.
model TenantSlugHistory {
  id        String   @id @default(cuid(2))
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  oldSlug   String   @unique
  changedAt DateTime @default(now())

  @@index([tenantId])
  @@map("tenant_slug_history")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductType {
  TEMPLATE
  SLIDE
  EBOOK
  EXAM
  OTHER
}

/// §"M5" — PRODUCTS. `coverImageKey` points at the PUBLIC bucket (direct
/// URL, no presign needed to display it) — the sellable files themselves
/// live in the private bucket via ProductFile. `salePriceVnd`/`saleStartsAt`/
/// `saleEndsAt` are columns only — M6 adds the pricing engine that reads
/// them. `downloadLimit=0` means unlimited (ADR-014). ADR-029 mục 3: điểm
/// đánh giá cache bằng 2 số nguyên `ratingSum`/`ratingCount` (không float) —
/// chỉ tính review VISIBLE, luôn tính lại toàn phần (SUM/COUNT) dưới scope
/// `system_job` (`recomputeProductRating`, apps/web/lib/review.ts).
model Product {
  id                  String            @id @default(cuid(2))
  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug                String
  title               String
  description         String?
  type                ProductType       @default(OTHER)
  /// ADR-027: mô tả ngắn — văn bản thuần ≤300 ký tự (chuẩn hoá/validate ở `normalizeProductSummary`,
  /// @gieochu/core). Hiển thị trên thẻ storefront và đầu trang chi tiết; không bắt buộc khi xuất bản.
  summary             String?
  /// Ảnh bìa cũ trên R2 public (M5). ADR-027: chỉ còn là fallback khi chưa có `coverImageUrl`.
  coverImageKey       String?
  /// ADR-027: ảnh bìa Cloudinary — chỉ nhận `https://res.cloudinary.com/...` (`isCloudinaryImageUrl`,
  /// cùng luật ADR-023). Ưu tiên hơn `coverImageKey` khi hiển thị (`resolveProductCoverUrl`).
  coverImageUrl       String?
  tags                String[]          @default([])
  priceVnd            Int               @default(0)
  salePriceVnd        Int?
  saleStartsAt        DateTime?
  saleEndsAt          DateTime?
  downloadLimit       Int               @default(5)
  ratingSum           Int               @default(0)
  ratingCount         Int               @default(0)
  /// ADR-033 mục 1: cache "số đã bán" = số order_items của đơn FULFILLED có entitlement chưa thu hồi (CHECK ≥ 0
  /// trong SQL). Chỉ ghi qua `recomputeProductSoldCounts` (scope system_job, tính lại toàn phần).
  soldCount           Int               @default(0)
  status              ProductStatus     @default(DRAFT)
  /// ADR-038 mục 5: khoá kiểm duyệt — admin lưu trữ sản phẩm do vi phạm (qua `system_job`). Khác null ⇒ tenant không
  /// đổi được `status` (không xuất bản lại/khôi phục) cho tới khi admin gỡ khoá. Trigger `products_guard_moderation`
  /// chặn mọi scope ngoài `system_job` đặt/gỡ 2 cột này hoặc đổi `status` khi đang khoá.
  moderationLockedAt  DateTime?
  /// Lý do hiển thị cho tenant = nhãn loại vi phạm (không chứa danh tính người báo cáo).
  moderationReason    String?
  /// ADR-038 mục 7: lần gần nhất tenant tích cam kết bản quyền khi xuất bản (lưu vết, không FK).
  rightsConfirmedAt   DateTime?
  rightsConfirmedById String?
  /// ADR-026: danh mục tài liệu (L1, System Admin quản lý). Nháp được để
  /// trống; xuất bản bắt buộc có danh mục đang `isActive` (canPublishProduct).
  /// Danh mục bị xoá (hiện chưa có luồng xoá) → SetNull, sản phẩm giữ nguyên.
  categoryId          String?
  category            DocumentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  files        ProductFile[]
  orderItems   OrderItem[]
  entitlements Entitlement[]
  shareLinks   ShareLink[]
  reviews      Review[]
  posts        Post[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([categoryId])
  @@map("products")
}

enum ProductFileScanStatus {
  PENDING
  CLEAN
  REJECTED
}

/// ADR-026: nguồn giao hàng của một dòng `product_files`.
enum ProductFileSource {
  FILE
  EXTERNAL_URL
}

/// §"M5" — PRODUCT_FILES. `tenantId` is denormalized from Product (per the
/// spec's own ERD) so RLS can scope this table the same way as `products`,
/// without a join. `removedAt` is a soft-hide only — the spec is explicit
/// that removing a file from a product that already has buyers must never
/// delete the underlying object (§5.2), so a real S3 delete only ever
/// happens from the file.scan job rejecting a file that was never CLEAN.
///
/// ADR-026: cùng bảng lưu cả **link tài liệu ngoài** (`sourceKind =
/// EXTERNAL_URL`). Dòng link: `externalUrl` có giá trị, `fileName` là nhãn
/// hiển thị, `objectKey`/`mimeType`/`scanStatus` = NULL (không quét, không có
/// object — NULL không vi phạm `@unique`), `sizeBytes = 0` (không tính dung
/// lượng), `isPreview = false`. CHECK constraint `product_files_source_shape`
/// (migration 20260926120000) ép đúng hình dạng này ở tầng DB. Mọi luồng file
/// cũ lọc `scanStatus = 'CLEAN'` nên tự loại dòng link; RLS nhánh public chỉ
/// cho `sourceKind = 'FILE'`.
model ProductFile {
  id              String                 @id @default(cuid(2))
  productId       String
  product         Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenantId        String
  sourceKind      ProductFileSource      @default(FILE)
  externalUrl     String?
  objectKey       String?                @unique
  storageBucket   String?
  storageProvider String?
  fileName        String
  mimeType        String?
  sizeBytes       Int
  sha256          String?
  scanStatus      ProductFileScanStatus? @default(PENDING)
  isPreview       Boolean                @default(false)
  removedAt       DateTime?
  createdAt       DateTime               @default(now())

  downloadTokens DownloadToken[]
  downloadEvents DownloadEvent[]
  productFilePreview ProductFilePreview?

  @@index([productId])
  @@index([tenantId])
  @@map("product_files")
}

/// ADR-063 — cache bản xem trước 20% nội dung thật (DOCX/XLSX/PDF/TEXT) cho trang chi tiết công khai.
/// L2 denormalized (`tenantId`/`productId` giống `product_files`), nhưng chỉ server đọc qua route guard —
/// không có policy RLS public (không bật). Cascade delete theo `product_files`.
model ProductFilePreview {
  productFileId String      @id
  productFile   ProductFile @relation(fields: [productFileId], references: [id], onDelete: Cascade)
  tenantId      String
  productId     String
  kind          String
  payload       Json
  ratio         Int         @default(20)
  schemaVersion Int         @default(1)
  generatedAt   DateTime    @default(now())

  @@index([productId])
  @@index([tenantId])
  @@map("product_file_previews")
}

/// §5.1 Layer System — system_settings. Single row (id fixed to "default").
/// ADR-032: cấu hình hệ thống do System Admin sửa ở /admin/settings/general
/// (apps/web/lib/system-settings.ts). 11 cột Int dưới đây là nguồn sự thật
/// duy nhất (không còn env TRIAL_DAYS/ACCESS_TOKEN_TTL...). Mặc định + giới
/// hạn khai báo ở packages/core/src/settings/system-settings.ts — DB default
/// chỉ để dòng cũ/dòng mới luôn có giá trị; lúc đọc vẫn parse phòng thủ (giá
/// trị ngoài khoảng → mặc định + log warn). Đổi giá trị chỉ áp cho thao tác mới.
/// supportEmail: form /admin/settings. Cột platformName đã xoá (ADR-032) —
/// tên nền tảng chỉ lấy từ SystemBranding / DEFAULT_BRAND.
/// trialDays: lưu + validate nhưng CHƯA dùng (Free Forever, ADR-021).
model SystemSettings {
  id                        String   @id @default("default")
  supportEmail              String?
  trialDays                 Int      @default(14)
  graceDays                 Int      @default(7)
  accessTokenTtlMinutes     Int      @default(15)
  refreshTokenTtlDays       Int      @default(7)
  emailVerifyTtlHours       Int      @default(24)
  passwordResetTtlMinutes   Int      @default(30)
  presignUploadTtlSeconds   Int      @default(600)
  presignDownloadTtlSeconds Int      @default(600)
  orderPendingTtlMinutes    Int      @default(60)
  /// ADR-061/062: hạn giữ đơn tính từ lúc đặt đơn theo phương thức — xác nhận tay (ngân hàng, MoMo) và chưa chọn phương thức.
  orderHoldManualHours      Int      @default(72)
  /// ADR-061/062: hạn giữ đơn với cổng tự xác nhận (SePay; MoMo API nếu bật).
  orderHoldAutoHours        Int      @default(48)
  invoicePendingTtlHours    Int      @default(24)
  defaultDownloadLimit      Int      @default(5)
  /// ADR-053 chính sách phiên (min/max ở packages/core/src/settings/system-settings.ts). refreshTokenTtlDays ở trên
  /// không còn dùng sau khi code ADR-053 lên prod — thay bằng sessionAbsoluteHours/rememberMeDays (contract sau).
  sessionIdleMinutes        Int      @default(60)
  sessionAbsoluteHours      Int      @default(12)
  rememberMeDays            Int      @default(30)
  adminIdleMinutes          Int      @default(15)
  adminAbsoluteHours        Int      @default(8)
  sessionWarningMinutes     Int      @default(2)
  /// User (SYSTEM_ADMIN) sửa lần cuối — không đặt FK để xoá user không chặn/đổi cấu hình.
  updatedById               String?
  updatedAt                 DateTime @updatedAt

  @@map("system_settings")
}

/// §"M5": SYSTEM_STORAGE_CONFIG. Single row — the platform has exactly one
/// object storage account (R2 in prod). Configured via System Admin
/// (/admin/settings/storage) instead of static env vars, same
/// publicConfig+encryptedSecrets shape and masking rules as
/// PlatformPaymentConfig (§7.3) — but encrypted with its own
/// STORAGE_ENCRYPTION_KEY, never PAYMENT_ENCRYPTION_KEY, so a leaked key
/// only ever exposes one secret domain (ADR-017). `publicConfig` holds
/// { endpoint, region, bucketPrivate, bucketPublic, publicBaseUrl? };
/// `encryptedSecrets` holds { accessKeyId, secretAccessKey }.
model SystemStorageConfig {
  id               String    @id @default("default")
  isEnabled        Boolean   @default(false)
  publicConfig     Json
  encryptedSecrets String
  lastVerifiedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("system_storage_config")
}

/// Tài khoản Cloudinary dùng để upload ảnh cho CMS (khác hẳn
/// SystemStorageConfig — đó là R2, dùng cho file tài liệu/ảnh bìa sản phẩm).
/// Cùng pattern mã hoá AES-256-GCM với SystemStorageConfig (§7.3).
model SystemCloudinaryConfig {
  id               String    @id @default("default")
  isEnabled        Boolean   @default(false)
  publicConfig     Json
  encryptedSecrets String
  lastVerifiedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("system_cloudinary_config")
}

/// Cấu hình gửi email hệ thống (System Admin, /admin/settings/smtp) — bắt đầu với
/// SMTP chuẩn (Gmail App Password). Các provider email khác (Resend, SES...) sẽ có
/// bảng riêng sau, theo đúng mẫu SystemStorageConfig/SystemCloudinaryConfig (mỗi
/// integration 1 bảng, không dồn chung 1 bảng đa-provider để tránh JSON lẫn lộn
/// field giữa các provider khác nhau).
model SystemSmtpConfig {
  id               String    @id @default("default")
  isEnabled        Boolean   @default(false)
  publicConfig     Json
  encryptedSecrets String
  lastVerifiedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("system_smtp_config")
}

/// Lịch sử gửi email CẤP PLATFORM (System Admin, tab "Lịch sử gửi" trong
/// /admin/settings/smtp) — CHỈ ghi email hệ thống: xác thực tài khoản, reset mật
/// khẩu, billing/subscription gửi cho CHỦ tenant, soát file, email test SMTP...
/// KHÔNG BAO GIỜ ghi email order_paid/new_sale (gửi tới khách hàng cuối của
/// tenant) — loại trừ ngay từ lúc ghi log (xem apps/web/lib/email-dispatch.ts),
/// không lọc lúc hiển thị, để giữ đúng ranh giới "System admin không đọc chi tiết
/// đơn hàng/khách hàng của tenant" (CLAUDE.md §7.9).
model EmailSendLog {
  id           String   @id @default(cuid(2))
  type         String
  recipient    String
  subject      String
  status       String
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("email_send_log")
}

/// Danh mục tài liệu — taxonomy CẤP PLATFORM do System Admin tạo trước
/// (/admin/categories), KHÔNG phải danh mục riêng của từng tenant. Sản phẩm
/// gắn qua `Product.categoryId` (ADR-026). Bảng L1 (không tenantId), không
/// cần RLS — cùng lớp với SystemBranding/Plan.
model DocumentCategory {
  id               String   @id @default(cuid(2))
  slug             String   @unique
  name             String
  shortDescription String?
  /// Rich text (HTML từ TiptapEditor, sanitize trước khi lưu — xem
  /// packages/core/src/content/sanitize-html.ts).
  description      String?
  imageUrl         String?
  seoTitle         String?
  seoDescription   String?
  /// Ảnh chia sẻ mạng xã hội — khuyến nghị 1200x630px.
  ogImageUrl       String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  products Product[]

  @@map("document_categories")
}

/// Nhận diện thương hiệu nền tảng (không phải branding riêng của từng
/// tenant — đó là `Tenant.branding`). Tất cả field đều nullable: null nghĩa
/// là "dùng mặc định" — brandName/brandSlogan rỗng thì `getEffectiveBrand()`
/// (apps/web/lib/branding.ts) rơi về `DEFAULT_BRAND` (@gieochu/config/brand,
/// ADR-032 — không còn env APP_NAME/APP_SLOGAN).
/// Không đặt bảng này trong @gieochu/config vì package đó không được phép
/// phụ thuộc @gieochu/db (packages/db mới là bên phụ thuộc config, ngược lại
/// sẽ tạo circular dependency).
model SystemBranding {
  id                 String   @id @default("default")
  logoLightUrl       String?
  logoDarkUrl        String?
  logoSquareUrl      String?
  logoSidebarUrl     String?
  logoFooterUrl      String?
  faviconUrl         String?
  ogImageUrl         String?
  brandName          String?
  brandSlogan        String?
  primaryColorHex    String?
  accentColorHex     String?
  secondaryColorHex  String?
  navbarLogoHeightPx Int      @default(56)
  updatedAt          DateTime @updatedAt

  @@map("system_branding")
}

enum PaymentProviderId {
  MANUAL_QR
  SEPAY
  MOMO
  /// ADR-059 bổ sung lần 3 — ví MoMo cá nhân, khách chuyển tay, người nhận xác nhận tay (không webhook).
  MOMO_MANUAL
}

/// §5.2 — TENANT_PAYMENT_CONFIGS. L2 (tenantId), RLS-protected like
/// products/tenant_members (packages/db/prisma/migrations/*_rls_m7/).
/// `encryptedSecrets` holds the AES-256-GCM ciphertext (packages/payments/src/encryption.ts);
/// plaintext secrets are never stored or returned to the client (§7.3).
model TenantPaymentConfig {
  id                String            @id @default(cuid(2))
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider          PaymentProviderId
  isEnabled         Boolean           @default(false)
  /// non-secret fields only (bank BIN, account no/name, partnerCode, environment...)
  publicConfig      Json
  encryptedSecrets  String
  webhookSecretHash String?
  lastVerifiedAt    DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@map("tenant_payment_configs")
}

/// §5.1 Layer System — platform_payment_configs. Same shape as
/// tenant_payment_configs but no tenantId (platform has exactly one config
/// per provider). Table created in M7; UI/business logic land in §"M3"
/// (apps/web/lib/platform-payment.ts) — saving auto-clears isEnabled/
/// lastVerifiedAt whenever the account/secret identity changes, so a config
/// never sits "enabled" with credentials nobody has re-confirmed.
model PlatformPaymentConfig {
  id                String            @id @default(cuid(2))
  provider          PaymentProviderId @unique
  isEnabled         Boolean           @default(false)
  publicConfig      Json
  encryptedSecrets  String
  webhookSecretHash String?
  lastVerifiedAt    DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("platform_payment_configs")
}

enum SubscriptionInvoiceStatus {
  PENDING
  PAID
  EXPIRED
  VOID
  /// ADR-041 B: admin đã chuyển khoản hoàn 100% (yêu cầu `subscription_refund_requests` APPROVED_REFUNDED).
  /// Không bao giờ quay lại PAID (markInvoicePaid bỏ qua hoá đơn REFUNDED).
  REFUNDED
}

/// §"M3" — SUBSCRIPTION_INVOICES. L1 like Subscription/Plan (billing is
/// system-managed even though each row references one tenant) — not RLS
/// protected; access is gated in the application layer by
/// requireTenantMember (owner reading their own invoices) or requireRole
/// SYSTEM_ADMIN (admin reviewing pending manual-transfer invoices).
/// amountVnd/periodStart/periodEnd are snapshotted from the Plan at
/// creation time — a later price change never rewrites an issued invoice.
model SubscriptionInvoice {
  id              String                    @id @default(cuid(2))
  tenantId        String
  tenant          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId          String
  plan            Plan                      @relation(fields: [planId], references: [id])
  code            String                    @unique
  provider        PaymentProviderId
  status          SubscriptionInvoiceStatus @default(PENDING)
  amountVnd       Int
  periodStart     DateTime
  periodEnd       DateTime
  dueAt           DateTime
  paidAt          DateTime?
  /// CheckoutResult (packages/payments) captured once at creation — read
  /// back by the billing page instead of re-calling the provider (MoMo's
  /// createCheckout hits their API; QR providers are cheap to recompute but
  /// stored the same way for a uniform read path).
  checkoutPayload Json?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  transactions  PlatformPaymentTransaction[]
  refundRequest SubscriptionRefundRequest?

  @@index([tenantId])
  @@map("subscription_invoices")
}

enum SubscriptionRefundStatus {
  REQUESTED
  APPROVED_REFUNDED
  REJECTED
}

/// ADR-041 B (+ bổ sung) — yêu cầu hoàn tiền gói trả phí. Bảng L1 (billing nền tảng, PaymentScope PLATFORM — như
/// subscription_invoices): không RLS; chủ gian hàng chỉ đọc/tạo dòng của tenant mình qua requireTenantMember(OWNER),
/// admin đọc/duyệt qua requireRole(SYSTEM_ADMIN) (§7.9: hoá đơn gói là L1, không phải đơn/khách của tenant).
/// Mỗi tenant tối đa 1 yêu cầu (chỉ lần thanh toán gói đầu tiên được hoàn) — `tenantId` và `invoiceId` đều unique.
/// `payoutEncrypted` = JSON {bankBin, bankName, accountNo, accountName} mã hoá AES-256-GCM (PAYMENT_ENCRYPTION_KEY),
/// chỉ admin giải mã; đặt NULL khi APPROVED_REFUNDED/REJECTED (CHECK). Không đưa vào audit/log/email.
/// `requestedById`/`decidedById` không FK (cùng mẫu products.rightsConfirmedById) — user không bị xoá ở MVP.
model SubscriptionRefundRequest {
  id              String                   @id @default(cuid(2))
  tenantId        String                   @unique
  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId       String                   @unique
  invoice         SubscriptionInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  requestedById   String
  /// Lý do (tuỳ chọn, văn bản thuần ≤500).
  reason          String?
  payoutEncrypted String?
  status          SubscriptionRefundStatus @default(REQUESTED)
  /// Số tiền hoàn (VND, số nguyên) = `amountVnd` của hoá đơn, chụp lúc tạo yêu cầu.
  amountVnd       Int
  /// Lý do từ chối / ghi chú admin (bắt buộc khi REJECTED — CHECK). Gửi cho chủ gian hàng.
  adminNote       String?
  decidedById     String?
  decidedAt       DateTime?
  refundedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([status, createdAt])
  @@map("subscription_refund_requests")
}

/// §"M3" — PLATFORM_PAYMENT_TRANSACTIONS. Every platform webhook event that
/// passed signature verification is recorded here, matched or not — the
/// sequence diagram's "Lệch số tiền hoặc không tìm thấy → lưu UNMATCHED để
/// admin xử lý" (matchedInvoiceId null = unmatched, admin reviews manually).
model PlatformPaymentTransaction {
  id               String               @id @default(cuid(2))
  provider         PaymentProviderId
  amountVnd        Int
  rawPayload       Json
  matchedInvoiceId String?
  matchedInvoice   SubscriptionInvoice? @relation(fields: [matchedInvoiceId], references: [id])
  createdAt        DateTime             @default(now())

  @@map("platform_payment_transactions")
}

enum WebhookScope {
  PLATFORM
  TENANT
}

/// §5.2 — webhook_events. Idempotency guard: a provider's event id must only
/// ever be processed once per scope+provider (§7.4). Written via
/// withSystemJob (no tenant session at the point a raw webhook arrives).
model WebhookEvent {
  id              String            @id @default(cuid(2))
  scope           WebhookScope
  provider        PaymentProviderId
  providerEventId String
  tenantId        String?
  receivedAt      DateTime          @default(now())

  @@unique([scope, provider, providerEventId])
  @@map("webhook_events")
}

/// §"M7": ngân hàng cho form chọn BIN khi cấu hình MANUAL_QR/SEPAY — seed từ
/// danh sách NAPAS/VietQR chính thức (packages/db/prisma/seed.ts).
model BankBin {
  bin       String @id
  name      String
  shortName String

  @@map("bank_bins")
}

enum CouponType {
  PERCENT
  FIXED
}

/// §"M6" — COUPONS. L2 (RLS like products/tenant_members). `productIds` is a
/// JSON array of Product ids (null/empty = applies to every product in the
/// tenant) — a plain array rather than a join table since it's small and
/// read as a unit by `calculatePrice()` (packages/core), never queried by
/// individual product id. `usedCount` is only ever incremented by M8's
/// order-PAID transition (`UPDATE ... WHERE usedCount < usageLimit`,
/// §"M6") — nothing in M6 itself writes it past the initial 0.
model Coupon {
  id               String     @id @default(cuid(2))
  tenantId         String
  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code             String
  type             CouponType
  value            Int
  maxDiscountVnd   Int?
  minOrderVnd      Int?
  usageLimit       Int?
  usedCount        Int        @default(0)
  perCustomerLimit Int?
  startsAt         DateTime?
  endsAt           DateTime?
  productIds       Json?
  isEnabled        Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  redemptions CouponRedemption[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("coupons")
}

/// §5.2 "Bảng phụ: coupon_redemptions (couponId, userId, orderId)". Written
/// once, atomically, by `markOrderPaid()` (§"M8") — `@@unique([couponId,
/// orderId])` makes a second attempt at the same order a no-op rather than
/// double-counting `usedCount`.
model CouponRedemption {
  id        String   @id @default(cuid(2))
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  tenantId  String
  userId    String
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([couponId, orderId])
  @@index([tenantId])
  @@map("coupon_redemptions")
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  EXPIRED
  CANCELED
  REFUNDED
}

/// §"M8" — ORDERS. L2 with an extra customer-ownership dimension: RLS
/// allows tenantId match (owner) OR customerId match under `app.scope =
/// 'customer'` (the buyer) OR system_job (§5.4) — see `_rls_m8`.
/// MVP is "mỗi đơn 1 sản phẩm" but `OrderItem` stays its own table (the
/// spec's own forward note) so a future cart just adds more rows.
model Order {
  id                             String             @id @default(cuid(2))
  tenantId                       String
  tenant                         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId                     String
  customer                       User               @relation(fields: [customerId], references: [id])
  code                           String             @unique
  status                         OrderStatus        @default(PENDING)
  subtotalVnd                    Int
  discountVnd                    Int                @default(0)
  totalVnd                       Int
  couponCode                     String?
  provider                       PaymentProviderId?
  /// CheckoutResult (packages/payments) captured once the customer picks a
  /// provider on the checkout page — read back instead of re-calling the
  /// provider (MoMo's createCheckout hits their API), same as
  /// SubscriptionInvoice.checkoutPayload (M3).
  checkoutPayload                Json?
  proofImageKey                  String?
  /// Ghi chú bắt buộc khi owner xác nhận thủ công (§"M8"), cùng mẫu với
  /// SubscriptionInvoice.confirmNote (M3).
  confirmNote                    String?
  expiresAt                      DateTime
  paidAt                         DateTime?
  /// ADR-062 Q1: lúc khách bấm "Tôi đã chuyển khoản" (chỉ cổng xác nhận tay). Không đổi `status`. Hoàn tác → NULL.
  customerDeclaredPaidAt         DateTime?
  /// ADR-061 Q9/Q10 — các mốc chống gửi sót/trùng email (nhận nguyên tử bằng `UPDATE … WHERE col IS NULL`):
  /// đã báo người bán "đơn chờ xác nhận tay" (một lần/đơn, kể cả khi khách đổi phương thức).
  ownerManualNotifiedAt          DateTime?
  /// đã báo người bán "khách báo đã chuyển" (ADR-062 Q1 — một lần/đơn, kể cả khi khách hoàn tác rồi báo lại).
  ownerDeclaredPaidNotifiedAt    DateTime?
  /// email cho khách lúc chọn phương thức (Q7): lần gửi gần nhất + phương thức đã gửi — đổi sang phương thức khác mới gửi lại.
  customerPaymentEmailedAt       DateTime?
  customerPaymentEmailedProvider PaymentProviderId?
  /// email nhắc khách khi còn ≤ 24 giờ (Q7, cron hằng ngày) — một lần/đơn.
  customerReminderSentAt         DateTime?
  createdAt                      DateTime           @default(now())
  updatedAt                      DateTime           @updatedAt

  items             OrderItem[]
  transactions      TenantPaymentTransaction[]
  couponRedemptions CouponRedemption[]
  notes             OrderNote[]

  @@index([tenantId])
  @@index([customerId])
  /// ADR-061 Q7: cron nhắc khách + sweep hết hạn quét theo (status, expiresAt).
  @@index([status, expiresAt])
  @@map("orders")
}

/// ADR-047 mục 2 — ghi chú nội bộ của chủ gian hàng trên một đơn. L2 (RLS FORCE, migration `adr045_order_notes`):
/// chỉ scope `tenant` (đúng `app.tenant_id`) + `system_job`; KHÔNG customer/public — khách không bao giờ đọc được.
/// Không UPDATE (không có policy update): chỉ thêm và xoá (xoá chỉ tác giả — kiểm ở `lib/order-note.ts`).
/// `body` đã trim, 1–1000 ký tự (CHECK `order_notes_body_length`). `authorId` SET NULL khi xoá user (giữ ghi chú).
model OrderNote {
  id        String   @id @default(cuid(2))
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation("OrderNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())

  @@index([tenantId, orderId, createdAt])
  @@index([orderId])
  @@index([authorId])
  @@map("order_notes")
}

/// §5.3 "order_items lưu snapshot tiêu đề và giá tại thời điểm mua" — a later
/// price/title change on Product never rewrites a placed order.
model OrderItem {
  id            String   @id @default(cuid(2))
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  titleSnapshot String
  unitPriceVnd  Int
  finalPriceVnd Int
  createdAt     DateTime @default(now())

  entitlement Entitlement?
  reviews     Review[]

  @@index([orderId])
  @@map("order_items")
}

enum PaymentMatchStatus {
  MATCHED
  UNMATCHED
  MISMATCH_AMOUNT
}

/// §5.3 unique `(tenantId, provider, providerTxnId)` — the same provider
/// event id can never be recorded twice for a tenant (idempotency at the
/// ledger level, separate from `webhook_events`' idempotency at the HTTP
/// delivery level).
model TenantPaymentTransaction {
  id            String             @id @default(cuid(2))
  tenantId      String
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId       String?
  order         Order?             @relation(fields: [orderId], references: [id])
  provider      PaymentProviderId
  providerTxnId String
  amountVnd     Int
  matchStatus   PaymentMatchStatus
  rawPayload    Json
  createdAt     DateTime           @default(now())

  @@unique([tenantId, provider, providerTxnId])
  @@index([tenantId])
  @@map("tenant_payment_transactions")
}

/// §5.3 unique `(tenantId, userId)` — one aggregate row per customer per
/// tenant, upserted (cộng dồn) by `markOrderPaid()`.
model TenantCustomer {
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  ordersCount   Int       @default(0)
  totalSpentVnd Int       @default(0)
  firstOrderAt  DateTime?
  lastOrderAt   DateTime?
  note          String?

  @@id([tenantId, userId])
  @@index([tenantId])
  @@map("tenant_customers")
}

/// §5.2 Layer L3 "Customer" — filtered by userId (M9 downloads read this).
/// `downloadLimit` is a snapshot of `product.downloadLimit` at purchase
/// time (§5.3 snapshot convention) — a later change to the product's limit
/// never retroactively changes what an existing buyer already has.
///
/// ADR-039 — quyền lợi người mua khi tài liệu bị admin lưu trữ do vi phạm (`remedy*`). Chỉ scope `system_job` đặt/đổi
/// (trigger `entitlements_guard_remedy`), ngoại lệ duy nhất: tenant hoàn tiền chuyển REFUND_REQUESTED → REFUNDED.
/// `remedyReportId` trỏ `abuse_reports.id` (L1) — không FK, chỉ để truy vết.
model Entitlement {
  id                String                  @id @default(cuid(2))
  userId            String
  user              User                    @relation(fields: [userId], references: [id])
  tenantId          String
  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId         String
  product           Product                 @relation(fields: [productId], references: [id])
  orderItemId       String                  @unique
  orderItem         OrderItem               @relation(fields: [orderItemId], references: [id])
  downloadsUsed     Int                     @default(0)
  downloadLimit     Int
  revokedAt         DateTime?
  createdAt         DateTime                @default(now())
  remedyStatus      EntitlementRemedyStatus @default(NONE)
  /// Thời điểm hệ thống mở quyền chọn (admin lưu trữ tài liệu do vi phạm).
  remedyRequestedAt DateTime?
  /// Thời điểm khách chọn (tải lần cuối / yêu cầu hoàn tiền) — mốc tính hạn 7 ngày của yêu cầu hoàn tiền.
  remedyChosenAt    DateTime?
  /// Thời điểm tenant bấm "Hoàn tiền" cho yêu cầu hoàn tiền (REFUND_REQUESTED → REFUNDED); null ở mọi trạng thái khác.
  remedyResolvedAt  DateTime?
  remedyReportId    String?

  downloadTokens DownloadToken[]
  downloadEvents DownloadEvent[]

  @@index([userId])
  @@index([tenantId])
  @@index([tenantId, remedyStatus])
  @@map("entitlements")
}

/// ADR-039. NONE = bình thường; PENDING_CHOICE = chặn tải, chờ khách chọn; FINAL_DOWNLOAD = còn đúng 1 lượt
/// (`downloadLimit = downloadsUsed + max(1, số tệp khả dụng)` — mỗi tệp 1 lần); REFUND_REQUESTED = chặn tải vĩnh viễn, chờ tenant hoàn tiền; REFUNDED = tenant
/// đã hoàn tiền (entitlement đã thu hồi).
enum EntitlementRemedyStatus {
  NONE
  PENDING_CHOICE
  FINAL_DOWNLOAD
  REFUND_REQUESTED
  REFUNDED
}

/// §"M9" — single-use, 60s-TTL token bridging `POST /api/downloads` (creates
/// it) and `GET /api/downloads/{token}` (consumes it). Same shape as
/// RefreshToken/VerificationToken (hash stored, never the raw token) and,
/// like them, **L1 — no RLS**: the security boundary is "only the customer
/// who just requested it holds the raw token", not a tenant/user row filter,
/// so a plain `getPrismaClient()` lookup by `tokenHash` is correct here.
model DownloadToken {
  id            String      @id @default(cuid(2))
  tokenHash     String      @unique
  entitlementId String
  entitlement   Entitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  fileId        String
  file          ProductFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Denormalized from `entitlement.tenantId` at creation — lets `consumeDownloadToken()`
  /// open one `withTenant()` transaction immediately, without an extra RLS-scoped lookup
  /// just to learn which tenant scope to use.
  tenantId      String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime    @default(now())

  @@index([entitlementId])
  @@map("download_tokens")
}

/// §"M9" — L2, RLS: tenantId match (owner manages/reads stats) OR
/// app.scope='public' (anonymous `/s/{token}` lookup by tokenHash — the row
/// is readable even when revoked/expired so the app can tell "never
/// existed" (404) apart from "no longer usable" (410), same reasoning as
/// Order's customer-scope clause not filtering by status either).
/// `fileIds` null/empty = every file currently sold for the product
/// (same "empty = no restriction" convention as Coupon.productIds, M6).
model ShareLink {
  id           String    @id @default(cuid(2))
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  label        String
  passwordHash String?
  fileIds      Json?
  maxUses      Int?
  usedCount    Int       @default(0)
  expiresAt    DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  downloadEvents DownloadEvent[]

  @@index([tenantId])
  @@map("share_links")
}

/// §"M9" — L2, RLS by tenantId only (audit trail for the owner; no
/// customer-facing read of raw events, unlike Entitlement). Exactly one of
/// `entitlementId`/`shareLinkId` is set per row — a logged-in customer's own
/// download vs. an anonymous share-link download.
model DownloadEvent {
  id            String       @id @default(cuid(2))
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fileId        String
  file          ProductFile  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  entitlementId String?
  entitlement   Entitlement? @relation(fields: [entitlementId], references: [id])
  shareLinkId   String?
  shareLink     ShareLink?   @relation(fields: [shareLinkId], references: [id])
  userId        String?
  user          User?        @relation(fields: [userId], references: [id])
  ip            String?
  createdAt     DateTime     @default(now())

  @@index([tenantId])
  @@index([fileId])
  @@map("download_events")
}

enum StorefrontMessageStatus {
  NEW
  READ
  ARCHIVED
}

/// ADR-023: tin nhắn từ form liên hệ trên storefront `/[tenantSlug]` — bảng L2 có RLS
/// (migration `rls_storefront_messages`): scope public chỉ INSERT, scope tenant
/// SELECT/UPDATE/DELETE đúng tenantId. System admin không có đường đọc (§7.9).
/// Không lưu IP thô — `ipHash` = HMAC-SHA256(ip), chỉ dùng cho rate limit.
model StorefrontMessage {
  id        String                  @id @default(cuid(2))
  tenantId  String
  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  email     String
  message   String
  status    StorefrontMessageStatus @default(NEW)
  ipHash    String?
  createdAt DateTime                @default(now())

  @@index([tenantId, createdAt])
  @@index([ipHash, createdAt])
  @@map("storefront_messages")
}

enum TenantMediaUsage {
  CONTENT
  PRODUCT_COVER
  STOREFRONT
  /// ADR-029 mục 5 (M10b): ảnh trong nội dung bài viết (folder `tenants/<id>/posts`).
  POST
}

/// ADR-028: ghi nhận ảnh tenant đã upload lên Cloudinary HỆ THỐNG để tính hạn mức `Plan.imageStorageMb`.
/// Bảng L2 có RLS (migration `rls_adr028_media_assets`, policy `tenant_isolation`: đúng tenantId hoặc scope
/// system_job cho job dọn asset sau này). Dòng được tạo khi CẤP CHỮ KÝ (giữ chỗ, `bytes` tạm tính,
/// `verifiedAt = null`) và cập nhật số thật khi server đọc Cloudinary Admin API (`verifiedAt` có giá trị) —
/// không bao giờ lấy `bytes` từ client. `publicId` do server sinh (nằm trong chữ ký upload).
model TenantMediaAsset {
  id         String           @id @default(cuid(2))
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  publicId   String           @unique
  bytes      Int
  format     String?
  width      Int?
  height     Int?
  usage      TenantMediaUsage
  /// null = mới giữ chỗ lúc ký, chưa xác minh với Cloudinary (bytes là mức tạm tính).
  verifiedAt DateTime?
  createdAt  DateTime         @default(now())

  @@index([tenantId, createdAt])
  @@map("tenant_media_assets")
}

enum ReviewStatus {
  VISIBLE
  HIDDEN
}

/// ADR-029 mục 2. `REFUNDED` chỉ do hệ thống đặt (hoàn tiền / thu hồi entitlement) — tenant không chọn được.
enum ReviewHiddenReason {
  SPAM
  OFFENSIVE
  IRRELEVANT
  PERSONAL_INFO
  REFUNDED
  OTHER
}

/// ADR-029 (M10a) — đánh giá sản phẩm. Bảng L2 có RLS tách theo lệnh (migration `rls_m10a_reviews`):
/// public đọc VISIBLE của sản phẩm PUBLISHED; customer đọc/ghi/xoá của chính mình (INSERT/UPDATE phải còn đơn
/// FULFILLED + entitlement chưa thu hồi); tenant đọc/UPDATE (ẩn, khôi phục, trả lời) của tenant mình; system_job.
/// Không nhánh admin (§7.9). Trigger `reviews_guard_columns` chặn customer đổi cột kiểm duyệt/trả lời và chặn
/// tenant đổi nội dung của khách. `orderItemId` = dòng đơn chứng minh quyền đánh giá (cập nhật khi khách mua lại
/// rồi sửa). `displayName` là snapshot tên rút gọn ("Minh A.") lúc ghi — trang public không join hồ sơ L1.
model Review {
  id                 String              @id @default(cuid(2))
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId          String
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItemId        String
  orderItem          OrderItem           @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  /// 1–5 (CHECK `reviews_rating_range`).
  rating             Int
  /// Văn bản thuần ≤2000 ký tự (CHECK), null = chỉ chấm sao.
  body               String?
  displayName        String
  status             ReviewStatus        @default(VISIBLE)
  /// Có giá trị ⇔ status = HIDDEN (CHECK `reviews_hidden_shape`).
  hiddenReason       ReviewHiddenReason?
  hiddenAt           DateTime?
  /// Trả lời của người bán (1 trả lời/đánh giá, sửa được), văn bản thuần ≤2000 ký tự.
  reply              String?
  repliedAt          DateTime?
  /// ADR-038 mục 5: khoá kiểm duyệt (admin ẩn do vi phạm, qua `system_job`). Khác null ⇒ tenant không bỏ ẩn được,
  /// hệ thống không tự khôi phục khi khách mua lại. Trigger `reviews_guard_moderation`.
  moderationLockedAt DateTime?
  moderationReason   String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([productId, userId])
  @@index([tenantId, createdAt])
  @@index([productId, status, createdAt])
  @@index([userId])
  @@index([orderItemId])
  @@map("reviews")
}

/// ADR-029 mục 5: tenant tự chuyển DRAFT ⇄ PUBLISHED; `HIDDEN` chỉ dành cho gỡ do vi phạm (M12) — tenant không đặt
/// được và không tự gỡ được (trigger `posts_guard_columns`).
enum PostStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

/// ADR-029 mục 5–6 (M10b) — bài viết tối giản của tenant. Bảng L2 có RLS tách theo lệnh (migration `rls_m10b_posts`):
/// public chỉ đọc PUBLISHED của tenant không LOCKED; tenant đọc/ghi/xoá bài của mình; system_job. Không nhánh
/// customer/admin (§7.9). `body` là HTML đã qua `sanitizeRichTextHtml` (ảnh chỉ Cloudinary hệ thống, ≤6 ảnh — kiểm
/// ở server). `excerpt` là văn bản thuần tự sinh từ `body` (≤300 ký tự). `productId` phải là sản phẩm CÙNG tenant
/// (trigger `posts_guard_product_tenant`); xoá sản phẩm → SetNull. Tối đa 1 bài ghim/tenant: partial unique index
/// `posts_tenantId_pinned_key` (`WHERE "isPinned"`, khai báo trong migration SQL — Prisma không biểu diễn được).
model Post {
  id                 String     @id @default(cuid(2))
  tenantId           String
  tenant             Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Tuỳ chọn, ≤200 ký tự (CHECK `posts_title_length`).
  title              String?
  body               String
  /// Văn bản thuần ≤300 ký tự sinh từ `body` khi lưu; "" khi bài chỉ có ảnh.
  excerpt            String     @default("")
  productId          String?
  product            Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  status             PostStatus @default(DRAFT)
  /// Chỉ có giá trị khi status = HIDDEN (M12 đặt, qua system_job).
  hiddenReason       String?
  isPinned           Boolean    @default(false)
  /// ADR-038 mục 5: khoá kiểm duyệt (admin ẩn do vi phạm, qua `system_job`; luôn đi cùng `status = HIDDEN`). Trigger
  /// `posts_guard_moderation` chặn scope khác đặt/gỡ hoặc đổi `status` khi đang khoá.
  moderationLockedAt DateTime?
  moderationReason   String?
  /// Lần xuất bản đầu tiên (giữ nguyên khi gỡ về DRAFT rồi đăng lại). Bắt buộc khi PUBLISHED (CHECK).
  publishedAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([tenantId, status, publishedAt(sort: Desc)])
  @@index([productId])
  @@map("posts")
}

/// ADR-037 (M12a): ai/hệ thống làm gì — `SYSTEM` = hành động cấp nền tảng (đăng nhập, quản trị hệ thống,
/// thanh toán gói, job hệ thống); `TENANT` = thành viên tenant thao tác trong Studio; `CUSTOMER` = khách hàng
/// thao tác (vd. mua lại làm đánh giá hiện lại).
enum AuditScope {
  SYSTEM
  TENANT
  CUSTOMER
}

/// ADR-037 mục 2 — §"M12" audit log, bảng L1 (không RLS; owner chỉ đọc qua loader lọc `tenantId` ở server,
/// apps/web/lib/audit-query.ts). CHỈ INSERT: role `gieochu_app` không có UPDATE, trigger
/// `audit_logs_block_update` chặn UPDATE mọi trường hợp, `audit_logs_guard_delete` chặn DELETE trừ khi phiên đặt
/// `gieochu.audit_purge = 'on'` VÀ dòng cũ hơn 12 tháng (cron hằng ngày, ADR-036). KHÔNG khoá ngoại tới
/// users/tenants (lịch sử bất biến, không chặn xoá dữ liệu khác). `action` là chuỗi (hằng `AUDIT_ACTIONS`,
/// @gieochu/core) — thêm action không cần DDL. `metadata` đã lọc khoá nhạy cảm (secret/token/password/hash) trước
/// khi ghi; hành động của tenant chỉ chứa id, không email khách/chi tiết đơn (§7.9). `createdAt` lưu UTC.
model AuditLog {
  id         String     @id @default(cuid(2))
  actorId    String?
  scope      AuditScope
  tenantId   String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json       @default("{}")
  ip         String?
  userAgent  String?
  createdAt  DateTime   @default(now())

  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

/// ADR-037 (M12b) — số liệu tổng hợp theo tenant + ngày giờ VN (`Asia/Ho_Chi_Minh`). Bảng L1: không RLS, admin đọc bằng
/// getPrismaClient(); chỉ job `stats.aggregate` (cron hằng ngày, chạy dưới withSystemJob) ghi. Chỉ chứa số đếm/tổng —
/// không email, tên khách hay mã đơn (§7.9). Tính lại được nên xoá theo tenant (Cascade), khác audit_logs.
model TenantDailyStat {
  id           String   @id @default(cuid(2))
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Ngày theo giờ Việt Nam (không phải ngày UTC).
  date         DateTime @db.Date
  ordersPaid   Int      @default(0)
  /// GMV gộp (VND, số nguyên) — tổng `orders.totalVnd` của đơn có `paidAt` trong ngày, kể cả đơn sau này hoàn tiền.
  gmvVnd       BigInt   @default(0)
  newCustomers Int      @default(0)
  downloads    Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, date])
  @@index([date])
  @@map("tenant_daily_stats")
}

/// ADR-038 mục 1 — đối tượng bị báo cáo (bình luận chưa có — M10c).
enum AbuseTargetType {
  PRODUCT
  REVIEW
  POST
}

/// ADR-038 mục 1 — loại vi phạm.
enum AbuseReportType {
  COPYRIGHT
  INAPPROPRIATE
  SCAM
  OTHER
}

enum AbuseReportStatus {
  OPEN
  RESOLVED
  REJECTED
}

/// ADR-038 mục 5 — quyết định của admin. `REJECT` ⇔ status REJECTED; 3 giá trị còn lại ⇔ RESOLVED (CHECK
/// `abuse_reports_decision_shape`).
enum AbuseReportDecision {
  HIDE_CONTENT
  ARCHIVE_PRODUCT
  LOCK_TENANT
  REJECT
}

/// ADR-038 mục 3 — báo cáo vi phạm, bảng L1 (không RLS; chỉ System Admin đọc qua apps/web/lib/abuse-report.ts — §7.9:
/// tenant KHÔNG bao giờ đọc bảng này, danh tính người báo cáo chỉ admin thấy). `tenantId` = tenant sở hữu đối tượng lúc
/// gửi (FK Cascade). `targetId` không FK (đối tượng thuộc 3 bảng khác nhau; bị xoá thì báo cáo vẫn giữ). `ip` dùng cho
/// giới hạn 5 báo cáo/giờ/IP, xoá (SET NULL) sau 12 tháng bởi cron hằng ngày. Thời gian lưu UTC.
model AbuseReport {
  id             String               @id @default(cuid(2))
  targetType     AbuseTargetType
  targetId       String
  tenantId       String
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type           AbuseReportType
  /// Văn bản thuần 1–2000 ký tự (CHECK).
  description    String
  /// ≤5 URL http/https (CHECK số phần tử; định dạng kiểm ở server).
  evidenceUrls   String[]             @default([])
  reporterUserId String?
  reporter       User?                @relation("AbuseReportReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  /// Email user đăng nhập hoặc email khách nhập — chỉ admin thấy, không bao giờ gửi cho tenant.
  reporterEmail  String
  ip             String?
  status         AbuseReportStatus    @default(OPEN)
  decision       AbuseReportDecision?
  /// Ghi chú nội bộ của admin (không gửi cho tenant/người báo cáo).
  resolutionNote String?
  resolvedById   String?
  resolvedBy     User?                @relation("AbuseReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([tenantId, createdAt])
  @@index([ip, createdAt])
  @@index([reporterUserId])
  @@index([resolvedById])
  @@map("abuse_reports")
}

/// ADR-050 mục 3 — trạng thái một phiên bản văn bản pháp lý. DRAFT sửa được; PUBLISHED/ARCHIVED bất biến nội dung
/// (trigger `legal_document_versions_freeze_content`) — sửa = tạo phiên bản mới.
enum LegalDocumentVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// ADR-050 mục 3 — đã qua rà soát pháp lý hay chưa. Là một trong hai cổng chặn xuất bản (bổ sung ADR-050 (c)): cần
/// APPROVED **và** nội dung không còn dấu `[[CẦN XÁC NHẬN`.
enum LegalReviewStatus {
  PENDING_LEGAL_REVIEW
  APPROVED
}

/// ADR-050 mục 3 — văn bản pháp lý hệ thống (L1, không `tenantId`, không RLS). Một dòng/văn bản; đợt 1 chỉ `key = "terms"`
/// (Điều khoản sử dụng, `/phap-ly/dieu-khoan-su-dung`). Ghi chỉ qua Server Action `requireRole("SYSTEM_ADMIN")` + audit.
model LegalDocument {
  id             String                 @id @default(cuid(2))
  /// Khoá ổn định trong code (vd `terms`).
  key            String                 @unique
  /// Segment URL cấp gốc `/{slug}` (vd `dieu-khoan-su-dung`, ADR-054; trước đó dưới `/phap-ly/`).
  slug           String                 @unique
  title          String
  /// ADR-054 — mô tả ngắn (≤ 320, fallback mô tả SEO); sửa thẳng trong CMS, không theo phiên bản.
  summary        String?
  /// ADR-054 — tiêu đề SEO (≤ 120, token `{brand}`); trống → "{title} | {brand}".
  seoTitle       String?
  /// ADR-054 — mô tả SEO (≤ 320, token `{brand}`); trống → `summary`.
  seoDescription String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  versions       LegalDocumentVersion[]

  @@map("legal_documents")
}

/// ADR-050 mục 3 — phiên bản văn bản. `version` số nguyên tăng dần theo văn bản (hiển thị nhãn ở UI). `contentHtml` đã
/// qua `sanitizeRichTextHtml` khi lưu; token `{brand}` thay lúc render (escape). Bản đang hiệu lực = PUBLISHED có
/// `effectiveAt <= now()` mới nhất. Thời gian lưu UTC.
model LegalDocumentVersion {
  id             String                     @id @default(cuid(2))
  documentId     String
  document       LegalDocument              @relation(fields: [documentId], references: [id], onDelete: Restrict)
  version        Int
  status         LegalDocumentVersionStatus @default(DRAFT)
  reviewStatus   LegalReviewStatus          @default(PENDING_LEGAL_REVIEW)
  contentHtml    String
  changeSummary  String?
  /// Bắt buộc khi PUBLISHED/ARCHIVED (CHECK).
  effectiveAt    DateTime?
  publishedAt    DateTime?
  /// ADR-057 — xuất bản dạng "Bản dự thảo" (bỏ qua cổng placeholder + rà soát): hiển thị công khai nhưng KHÔNG dùng để
  /// ghi nhận đồng ý. Đóng băng sau khi rời DRAFT (trigger `legal_document_versions_freeze_content`).
  isDraftRelease Boolean                    @default(false)
  /// Không FK (mẫu `updatedById`) — lịch sử không chặn xoá user.
  publishedById  String?
  createdById    String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  acceptances    UserLegalAcceptance[]

  @@unique([documentId, version])
  @@index([documentId, status, effectiveAt])
  @@map("legal_document_versions")
}

/// ADR-050 mục 3 — người dùng chấp thuận đúng một phiên bản (ghi trong cùng giao dịch tạo tài khoản lúc đăng ký).
/// L1, append-only với `gieochu_app` (không UPDATE). **Không lưu IP/User-Agent** (chủ dự án chốt). Xoá user → Cascade.
model UserLegalAcceptance {
  id         String               @id @default(cuid(2))
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  versionId  String
  version    LegalDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  acceptedAt DateTime             @default(now())

  @@unique([userId, versionId])
  @@index([versionId])
  @@map("user_legal_acceptances")
}

/// ADR-053 bổ sung lần 3 — loại thực thể của nháp tự động trong Studio (L2).
enum TenantEditorDraftEntity {
  POST
  PRODUCT
  STOREFRONT
}

/// ADR-053 bổ sung lần 3 — loại thực thể của nháp tự động trong System Center (L1).
enum SystemEditorDraftEntity {
  HOME
  SHOP
  PRICING
  MENU
  LEGAL_VERSION
}

/// ADR-053 bổ sung lần 3 — nháp tự động của editor Studio, **theo từng người dùng** (L2, RLS chỉ nhánh `tenant` +
/// `system_job`; không public/customer/admin — §7.9). Truy cập qua `withTenant` + lọc `userId` ở server
/// (`apps/web/lib/editor-draft.ts`). Autosave không bao giờ ghi vào bản đã lưu/live. `entityKey` = id thực thể hoặc
/// `"new"` (trang Tạo). `revision` tăng mỗi lần lưu (xung đột nhiều tab); `clientId` = tab đã ghi. `payload` không ghi log.
model TenantEditorDraft {
  id            String                  @id @default(cuid(2))
  tenantId      String
  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType    TenantEditorDraftEntity
  entityKey     String
  payload       Json
  revision      Int                     @default(1)
  clientId      String
  /// `updatedAt` của bản đã lưu lúc nháp bắt đầu (null với thực thể mới) — để báo "dựa trên bản cũ hơn".
  baseUpdatedAt DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([tenantId, userId, entityType, entityKey])
  @@index([updatedAt])
  @@index([userId])
  @@map("tenant_editor_drafts")
}

/// ADR-053 bổ sung lần 3 — nháp tự động của editor System Center (L1, không `tenantId`, không RLS). Chỉ truy cập qua
/// `getPrismaClient()` sau `requireRole("SYSTEM_ADMIN")`. Cột như `TenantEditorDraft`.
model SystemEditorDraft {
  id            String                  @id @default(cuid(2))
  userId        String
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType    SystemEditorDraftEntity
  entityKey     String
  payload       Json
  revision      Int                     @default(1)
  clientId      String
  baseUpdatedAt DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([userId, entityType, entityKey])
  @@index([updatedAt])
  @@map("system_editor_drafts")
}

/// ADR-061 Q1 — bộ đếm giới hạn tần suất dùng chung giữa các instance (Vercel/VPS), thay cho bộ đếm trong bộ nhớ ở các luồng
/// cần chống lạm dụng thật (tạo tài khoản khách vãng lai, gửi email kích hoạt). L1, không RLS. `key` là chuỗi đã băm
/// (vd `guest_signup:ip:<sha256>` / `guest_signup:email:<sha256>`) — không lưu IP/email thô. Cron hằng ngày xoá dòng đã hết hạn.
model RateLimitCounter {
  id        String   @id @default(cuid(2))
  key       String   @unique
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
  @@map("rate_limit_counters")
}
