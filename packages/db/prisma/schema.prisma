// Gieo Chữ — Prisma schema
// Grows module by module per docs/GIEOCHU_PROMPT_MVP_PHASE1.md §10.
// M0: only the models needed to seed a working foundation (system admin,
// sample plans, CMS home page). M1 adds UserProfile/RefreshToken/
// VerificationToken; later modules add the tenant/product/order graph.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: connection URLs live in prisma.config.ts (CLI/migrate uses
// DIRECT_URL), not here. The app's runtime PrismaClient gets its own adapter
// built from DATABASE_URL in src/client.ts — see docs/DECISIONS.md ADR-003.
datasource db {
  provider = "postgresql"
}

enum SystemRole {
  USER
  SYSTEM_ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  LOCKED
}

/// §5.1 Layer System — USERS
model User {
  id                 String     @id @default(cuid(2))
  email              String     @unique
  passwordHash       String
  systemRole         SystemRole @default(USER)
  status             UserStatus @default(PENDING)
  emailVerifiedAt    DateTime?
  profileCompletedAt DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  profile            UserProfile?
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]
  ownedTenant        Tenant?
  tenantMemberships  TenantMember[]

  @@map("users")
}

/// §5.1 Layer System — USER_PROFILES. Created at registration with just
/// fullName + consentAt; phone/occupation/province start null and are filled
/// in during the mandatory profile-completion step (isProfileComplete()
/// checks all four — see packages/auth/src/profile.ts).
model UserProfile {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  phone      String?
  avatarKey  String?
  occupation String?
  province   String?
  consentAt  DateTime

  @@map("user_profiles")
}

/// §5.1 Layer System — REFRESH_TOKENS (rotated on every use; reuse of a
/// replaced token revokes the whole familyId — see M1 sequence diagram).
model RefreshToken {
  id           String    @id @default(cuid(2))
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId     String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum VerificationTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

/// §5.1 Layer System — VERIFICATION_TOKENS (email activation + password reset)
model VerificationToken {
  id        String                @id @default(cuid(2))
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      VerificationTokenType
  tokenHash String                @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  @@index([userId, type])
  @@map("verification_tokens")
}

enum PlanInterval {
  MONTH
  YEAR
}

/// §5.1 Layer System — PLANS (subscription plans System admin manages)
model Plan {
  id            String       @id @default(cuid(2))
  code          String       @unique
  name          String
  priceVnd      Int
  interval      PlanInterval
  intervalCount Int          @default(1)
  maxProducts   Int
  storageMb     Int
  maxFileMb     Int
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

enum CmsPageStatus {
  DRAFT
  PUBLISHED
}

/// §5.1 Layer System — cms_pages (marketing content blocks)
model CmsPage {
  id             String        @id @default(cuid(2))
  slug           String        @unique
  title          String
  blocks         Json
  status         CmsPageStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("cms_pages")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE
  EXPIRED
  CANCELED
}

/// §5.1 Layer System — SUBSCRIPTIONS. Minimal shape forward-declared here so
/// M4 onboarding can open a TRIALING row; M3 — Subscription và Platform
/// Billing adds invoices, the sweep job, and the rest of the state machine.
model Subscription {
  id                 String             @id @default(cuid(2))
  tenantId           String             @unique
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id])
  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  graceEndsAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@map("subscriptions")
}

enum TenantStatus {
  ACTIVE
  READ_ONLY
  LOCKED
}

/// §5.2 Layer Tenant — TENANTS. Each row is an L2 root; tenant-scoped child
/// tables (tenant_members, products, ...) carry tenant_id and are protected
/// by RLS policies (packages/db/prisma/migrations/*_rls_m4/) enforced
/// through withTenant/withPublic/withCustomer/withSystemJob (packages/db/src/rls.ts).
model Tenant {
  id               String       @id @default(cuid(2))
  slug             String       @unique
  ownerId          String       @unique
  owner            User         @relation(fields: [ownerId], references: [id])
  name             String
  bio              String?
  logoKey          String?
  coverKey         String?
  /// { primaryColor, accentColor, socialLinks: { facebook?, youtube?, tiktok?, zalo?, website? } }
  branding         Json?
  orderCodePrefix  String       @unique
  status           TenantStatus @default(ACTIVE)
  storageUsedBytes Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  members      TenantMember[]
  slugHistory  TenantSlugHistory[]
  subscription Subscription?
  products     Product[]

  @@map("tenants")
}

enum TenantMemberRole {
  OWNER
  STAFF
}

/// §5.2 — TENANT_MEMBERS. MVP only ever creates OWNER rows (§2.2: staff with
/// fine-grained permissions is out of scope, schema is ready for later).
model TenantMember {
  tenantId String
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     TenantMemberRole @default(OWNER)
  joinedAt DateTime         @default(now())

  @@id([tenantId, userId])
  @@index([tenantId])
  @@map("tenant_members")
}

/// §4.3 — used to 301-redirect an old slug (changed at most once/30 days) to
/// the tenant's current one.
model TenantSlugHistory {
  id        String   @id @default(cuid(2))
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  oldSlug   String   @unique
  changedAt DateTime @default(now())

  @@index([tenantId])
  @@map("tenant_slug_history")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// §5.2 — PRODUCTS. Minimal shape forward-declared so the M4 storefront can
/// filter by status; M5 — Sản phẩm và File tài liệu adds price, files,
/// description, and the rest.
model Product {
  id        String        @id @default(cuid(2))
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug      String
  title     String
  status    ProductStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("products")
}
