// Gieo Chữ — Prisma schema
// Grows module by module per docs/GIEOCHU_PROMPT_MVP_PHASE1.md §10.
// M0: only the models needed to seed a working foundation (system admin,
// sample plans, CMS home page). M1 adds UserProfile/RefreshToken/
// VerificationToken; later modules add the tenant/product/order graph.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: connection URLs live in prisma.config.ts (CLI/migrate uses
// DIRECT_URL), not here. The app's runtime PrismaClient gets its own adapter
// built from DATABASE_URL in src/client.ts — see docs/DECISIONS.md ADR-003.
datasource db {
  provider = "postgresql"
}

enum SystemRole {
  USER
  SYSTEM_ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  LOCKED
}

/// §5.1 Layer System — USERS
model User {
  id                    String     @id @default(cuid(2))
  email                 String     @unique
  passwordHash          String
  systemRole            SystemRole @default(USER)
  status                UserStatus @default(PENDING)
  /// §"M2": only the seeded super admin can be granted/locked with no further
  /// checks bypassed — the *one* admin nobody (incl. other admins) can lock.
  isSuperAdmin          Boolean    @default(false)
  emailVerifiedAt       DateTime?
  profileCompletedAt    DateTime?
  lastLoginAt           DateTime?
  /// Đếm liên tiếp số lần sai mật khẩu (chỉ khi email có thật — xem
  /// apps/web/app/api/auth/login/route.ts). Về 0 khi đăng nhập thành công
  /// hoặc khi đặt lại mật khẩu thành công. Đạt 5 -> `passwordResetRequired`.
  failedLoginAttempts   Int        @default(0)
  /// True khi `failedLoginAttempts` chạm ngưỡng — chặn đăng nhập (kể cả đúng
  /// mật khẩu) cho tới khi đặt lại mật khẩu qua /forgot-password, KHÔNG liên
  /// quan `status` (đó là khoá admin/email-chưa-xác-minh, khác concern).
  passwordResetRequired Boolean    @default(false)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  profile            UserProfile?
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]
  ownedTenant        Tenant?
  tenantMemberships  TenantMember[]
  orders             Order[]
  entitlements       Entitlement[]
  tenantCustomerOf   TenantCustomer[]
  downloadTokens     DownloadToken[]
  downloadEvents     DownloadEvent[]
  reviews            Review[]

  @@map("users")
}

/// §5.1 Layer System — USER_PROFILES. Created at registration with just
/// fullName + consentAt; phone/province tự nguyện điền sau qua /account/profile
/// (không còn là cổng bắt buộc trước khi dùng hệ thống — xem
/// packages/auth/src/profile.ts isProfileComplete()). `occupation` không còn
/// dùng (từng trùng lựa chọn loại tài khoản lúc đăng ký) — giữ cột nullable,
/// không migrate xoá.
model UserProfile {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  phone      String?
  avatarKey  String?
  occupation String?
  province   String?
  consentAt  DateTime

  @@map("user_profiles")
}

/// §5.1 Layer System — REFRESH_TOKENS (rotated on every use; reuse of a
/// replaced token revokes the whole familyId — see M1 sequence diagram).
model RefreshToken {
  id           String    @id @default(cuid(2))
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId     String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum VerificationTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

/// §5.1 Layer System — VERIFICATION_TOKENS (email activation + password reset)
model VerificationToken {
  id        String                @id @default(cuid(2))
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      VerificationTokenType
  tokenHash String                @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  @@index([userId, type])
  @@map("verification_tokens")
}

enum PlanInterval {
  MONTH
  YEAR
}

/// §5.1 Layer System — PLANS (subscription plans System admin manages)
/// §"M3 v2" ADR-021: `isFree` marks the plan `createTenantForUser()` assigns
/// to every new tenant and that `subscription-sweep.ts` excludes from
/// GRACE/EXPIRED sweeping and downgrades a lapsed paid subscription back to.
/// `features` are boolean entitlement flags (see
/// `packages/core/src/billing/feature-gate.ts`) — business logic reads
/// these, never `plan.code`, so plan packaging stays a pure commercial
/// concern editable from System Admin.
model Plan {
  id             String       @id @default(cuid(2))
  code           String       @unique
  name           String
  priceVnd       Int
  interval       PlanInterval
  intervalCount  Int          @default(1)
  maxProducts    Int
  storageMb      Int
  maxFileMb      Int
  /// ADR-028: hạn mức ảnh Cloudinary (MB) — cộng chung ảnh mô tả + ảnh bìa + ảnh storefront (`tenant_media_assets`).
  /// Default 100 = mức FREE, an toàn cho gói tạo mới chưa đặt số.
  imageStorageMb Int          @default(100)
  isFree         Boolean      @default(false)
  features       Json         @default("{}")
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  subscriptions Subscription[]
  invoices      SubscriptionInvoice[]

  @@map("plans")
}

enum RoleScope {
  SYSTEM
  TENANT
}

/// L1 — nguồn sự thật cho "tier này được làm gì", thay các hàm hardcode TS
/// (`canManageTenant()`...). Role là định nghĩa toàn cục (không phải row
/// theo từng tenant) — mọi OWNER/STAFF của mọi tenant cùng trỏ về 1 Role qua
/// `code`, đối chiếu với `User.systemRole` / `TenantMember.role` (giữ
/// nguyên làm nhãn định danh, không đổi thành FK — xem ADR-022) lúc đọc.
/// `code` khớp enum theo quy ước seed: SYSTEM_ADMIN, TENANT_OWNER,
/// TENANT_STAFF.
model Role {
  id          String    @id @default(cuid(2))
  code        String    @unique
  scope       RoleScope
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  permissions RolePermission[]

  @@map("roles")
}

/// 1 row / hành động có thể cấp quyền, namespace kiểu "system:manage_users",
/// "tenant:manage_products".
model Permission {
  id          String   @id @default(cuid(2))
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum CmsPageStatus {
  DRAFT
  PUBLISHED
}

/// §5.1 Layer System — cms_pages (marketing content blocks)
/// `blocks` là bản LIVE (đang hiển thị công khai). `blocksDraft` là bản đang
/// sửa dở — null nghĩa là chưa có nháp nào khác bản live. Lưu nháp chỉ ghi
/// `blocksDraft`, không đụng `blocks`; Publish copy blocksDraft -> blocks rồi
/// xoá blocksDraft; "Khôi phục live" xoá blocksDraft để quay lại đúng bản live.
model CmsPage {
  id             String        @id @default(cuid(2))
  slug           String        @unique
  title          String
  blocks         Json
  blocksDraft    Json?
  status         CmsPageStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("cms_pages")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE
  EXPIRED
  CANCELED
}

/// §5.1 Layer System — SUBSCRIPTIONS. M4 onboarding opens the TRIALING row;
/// §"M3" adds invoices, the sweep job (subscription.sweep), and the rest of
/// the state machine (packages/core/src/billing/subscription-state.ts).
/// PAST_DUE is declared on SubscriptionStatus but never assigned by M3's
/// state machine (only TRIALING/ACTIVE/GRACE/EXPIRED/CANCELED per the
/// mermaid diagram in the spec) — same "declared, unused" pattern as
/// PlatformInvoiceStatus.VOID in the TaniGos report used to design this
/// module; left in place rather than removed in case a later phase needs it.
model Subscription {
  id                     String             @id @default(cuid(2))
  tenantId               String             @unique
  tenant                 Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId                 String
  plan                   Plan               @relation(fields: [planId], references: [id])
  status                 SubscriptionStatus @default(TRIALING)
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  graceEndsAt            DateTime?
  /// Which pre-expiry reminder (7 or 1 day) was last sent for the CURRENT
  /// period — null means none yet. Reset to null on every period renewal
  /// (subscription-billing.ts markInvoicePaid) and on entering GRACE, so a
  /// later period's reminders always start fresh instead of skipping.
  periodEndReminderStage Int?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@map("subscriptions")
}

enum TenantStatus {
  ACTIVE
  READ_ONLY
  LOCKED
}

/// §5.2 Layer Tenant — TENANTS. Each row is an L2 root; tenant-scoped child
/// tables (tenant_members, products, ...) carry tenant_id and are protected
/// by RLS policies (packages/db/prisma/migrations/*_rls_m4/) enforced
/// through withTenant/withPublic/withCustomer/withSystemJob (packages/db/src/rls.ts).
model Tenant {
  id                      String       @id @default(cuid(2))
  slug                    String       @unique
  ownerId                 String       @unique
  owner                   User         @relation(fields: [ownerId], references: [id])
  name                    String
  bio                     String?
  logoKey                 String?
  coverKey                String?
  /// { primaryColor, accentColor, socialLinks: { facebook?, youtube?, tiktok?, zalo?, website? } }
  branding                Json?
  /// ADR-023: storefront sections đã xuất bản (validate bằng `storefrontSectionsSchema`, @gieochu/core). null = chưa từng xuất bản → nội dung demo sinh trong code.
  storefrontSections      Json?
  /// ADR-023: bản nháp đang soạn trong Studio; null = không có nháp.
  storefrontSectionsDraft Json?
  orderCodePrefix         String       @unique
  status                  TenantStatus @default(ACTIVE)
  storageUsedBytes        Int          @default(0)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  members              TenantMember[]
  slugHistory          TenantSlugHistory[]
  subscription         Subscription?
  products             Product[]
  paymentConfigs       TenantPaymentConfig[]
  subscriptionInvoices SubscriptionInvoice[]
  coupons              Coupon[]
  orders               Order[]
  transactions         TenantPaymentTransaction[]
  customers            TenantCustomer[]
  entitlements         Entitlement[]
  shareLinks           ShareLink[]
  downloadEvents       DownloadEvent[]
  storefrontMessages   StorefrontMessage[]
  mediaAssets          TenantMediaAsset[]
  reviews              Review[]
  posts                Post[]

  @@map("tenants")
}

enum TenantMemberRole {
  OWNER
  STAFF
}

/// §5.2 — TENANT_MEMBERS. MVP only ever creates OWNER rows (§2.2: staff with
/// fine-grained permissions is out of scope, schema is ready for later).
model TenantMember {
  tenantId String
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     TenantMemberRole @default(OWNER)
  joinedAt DateTime         @default(now())

  @@id([tenantId, userId])
  @@index([tenantId])
  @@map("tenant_members")
}

/// §4.3 — used to 301-redirect an old slug (changed at most once/30 days) to
/// the tenant's current one.
model TenantSlugHistory {
  id        String   @id @default(cuid(2))
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  oldSlug   String   @unique
  changedAt DateTime @default(now())

  @@index([tenantId])
  @@map("tenant_slug_history")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductType {
  TEMPLATE
  SLIDE
  EBOOK
  EXAM
  OTHER
}

/// §"M5" — PRODUCTS. `coverImageKey` points at the PUBLIC bucket (direct
/// URL, no presign needed to display it) — the sellable files themselves
/// live in the private bucket via ProductFile. `salePriceVnd`/`saleStartsAt`/
/// `saleEndsAt` are columns only — M6 adds the pricing engine that reads
/// them. `downloadLimit=0` means unlimited (ADR-014). ADR-029 mục 3: điểm
/// đánh giá cache bằng 2 số nguyên `ratingSum`/`ratingCount` (không float) —
/// chỉ tính review VISIBLE, luôn tính lại toàn phần (SUM/COUNT) dưới scope
/// `system_job` (`recomputeProductRating`, apps/web/lib/review.ts).
model Product {
  id            String            @id @default(cuid(2))
  tenantId      String
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug          String
  title         String
  description   String?
  type          ProductType       @default(OTHER)
  /// ADR-027: mô tả ngắn — văn bản thuần ≤300 ký tự (chuẩn hoá/validate ở `normalizeProductSummary`,
  /// @gieochu/core). Hiển thị trên thẻ storefront và đầu trang chi tiết; không bắt buộc khi xuất bản.
  summary       String?
  /// Ảnh bìa cũ trên R2 public (M5). ADR-027: chỉ còn là fallback khi chưa có `coverImageUrl`.
  coverImageKey String?
  /// ADR-027: ảnh bìa Cloudinary — chỉ nhận `https://res.cloudinary.com/...` (`isCloudinaryImageUrl`,
  /// cùng luật ADR-023). Ưu tiên hơn `coverImageKey` khi hiển thị (`resolveProductCoverUrl`).
  coverImageUrl String?
  tags          String[]          @default([])
  priceVnd      Int               @default(0)
  salePriceVnd  Int?
  saleStartsAt  DateTime?
  saleEndsAt    DateTime?
  downloadLimit Int               @default(5)
  ratingSum     Int               @default(0)
  ratingCount   Int               @default(0)
  status        ProductStatus     @default(DRAFT)
  /// ADR-026: danh mục tài liệu (L1, System Admin quản lý). Nháp được để
  /// trống; xuất bản bắt buộc có danh mục đang `isActive` (canPublishProduct).
  /// Danh mục bị xoá (hiện chưa có luồng xoá) → SetNull, sản phẩm giữ nguyên.
  categoryId    String?
  category      DocumentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  files        ProductFile[]
  orderItems   OrderItem[]
  entitlements Entitlement[]
  shareLinks   ShareLink[]
  reviews      Review[]
  posts        Post[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([categoryId])
  @@map("products")
}

enum ProductFileScanStatus {
  PENDING
  CLEAN
  REJECTED
}

/// ADR-026: nguồn giao hàng của một dòng `product_files`.
enum ProductFileSource {
  FILE
  EXTERNAL_URL
}

/// §"M5" — PRODUCT_FILES. `tenantId` is denormalized from Product (per the
/// spec's own ERD) so RLS can scope this table the same way as `products`,
/// without a join. `removedAt` is a soft-hide only — the spec is explicit
/// that removing a file from a product that already has buyers must never
/// delete the underlying object (§5.2), so a real S3 delete only ever
/// happens from the file.scan job rejecting a file that was never CLEAN.
///
/// ADR-026: cùng bảng lưu cả **link tài liệu ngoài** (`sourceKind =
/// EXTERNAL_URL`). Dòng link: `externalUrl` có giá trị, `fileName` là nhãn
/// hiển thị, `objectKey`/`mimeType`/`scanStatus` = NULL (không quét, không có
/// object — NULL không vi phạm `@unique`), `sizeBytes = 0` (không tính dung
/// lượng), `isPreview = false`. CHECK constraint `product_files_source_shape`
/// (migration 20260926120000) ép đúng hình dạng này ở tầng DB. Mọi luồng file
/// cũ lọc `scanStatus = 'CLEAN'` nên tự loại dòng link; RLS nhánh public chỉ
/// cho `sourceKind = 'FILE'`.
model ProductFile {
  id          String                 @id @default(cuid(2))
  productId   String
  product     Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenantId    String
  sourceKind  ProductFileSource      @default(FILE)
  externalUrl String?
  objectKey   String?                @unique
  fileName    String
  mimeType    String?
  sizeBytes   Int
  sha256      String?
  scanStatus  ProductFileScanStatus? @default(PENDING)
  isPreview   Boolean                @default(false)
  removedAt   DateTime?
  createdAt   DateTime               @default(now())

  downloadTokens DownloadToken[]
  downloadEvents DownloadEvent[]

  @@index([productId])
  @@index([tenantId])
  @@map("product_files")
}

/// §5.1 Layer System — system_settings. Single row (id fixed to "default").
/// trialDays/graceDays seed from the TRIAL_DAYS/GRACE_DAYS env defaults
/// (packages/config) but are the live source of truth once this row exists —
/// business logic (M4 onboarding, M3 sweep) reads from here, not the env var.
model SystemSettings {
  id           String   @id @default("default")
  platformName String
  supportEmail String
  trialDays    Int
  graceDays    Int
  updatedAt    DateTime @updatedAt

  @@map("system_settings")
}

/// §"M5": SYSTEM_STORAGE_CONFIG. Single row — the platform has exactly one
/// object storage account (R2 in prod). Configured via System Admin
/// (/admin/settings/storage) instead of static env vars, same
/// publicConfig+encryptedSecrets shape and masking rules as
/// PlatformPaymentConfig (§7.3) — but encrypted with its own
/// STORAGE_ENCRYPTION_KEY, never PAYMENT_ENCRYPTION_KEY, so a leaked key
/// only ever exposes one secret domain (ADR-017). `publicConfig` holds
/// { endpoint, region, bucketPrivate, bucketPublic, publicBaseUrl? };
/// `encryptedSecrets` holds { accessKeyId, secretAccessKey }.
model SystemStorageConfig {
  id               String    @id @default("default")
  isEnabled        Boolean   @default(false)
  publicConfig     Json
  encryptedSecrets String
  lastVerifiedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("system_storage_config")
}

/// Tài khoản Cloudinary dùng để upload ảnh cho CMS (khác hẳn
/// SystemStorageConfig — đó là R2, dùng cho file tài liệu/ảnh bìa sản phẩm).
/// Cùng pattern mã hoá AES-256-GCM với SystemStorageConfig (§7.3).
model SystemCloudinaryConfig {
  id               String    @id @default("default")
  isEnabled        Boolean   @default(false)
  publicConfig     Json
  encryptedSecrets String
  lastVerifiedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("system_cloudinary_config")
}

/// Cấu hình gửi email hệ thống (System Admin, /admin/settings/smtp) — bắt đầu với
/// SMTP chuẩn (Gmail App Password). Các provider email khác (Resend, SES...) sẽ có
/// bảng riêng sau, theo đúng mẫu SystemStorageConfig/SystemCloudinaryConfig (mỗi
/// integration 1 bảng, không dồn chung 1 bảng đa-provider để tránh JSON lẫn lộn
/// field giữa các provider khác nhau).
model SystemSmtpConfig {
  id               String    @id @default("default")
  isEnabled        Boolean   @default(false)
  publicConfig     Json
  encryptedSecrets String
  lastVerifiedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("system_smtp_config")
}

/// Lịch sử gửi email CẤP PLATFORM (System Admin, tab "Lịch sử gửi" trong
/// /admin/settings/smtp) — CHỈ ghi email hệ thống: xác thực tài khoản, reset mật
/// khẩu, billing/subscription gửi cho CHỦ tenant, soát file, email test SMTP...
/// KHÔNG BAO GIỜ ghi email order_paid/new_sale (gửi tới khách hàng cuối của
/// tenant) — loại trừ ngay từ lúc ghi log (xem apps/web/lib/email-dispatch.ts),
/// không lọc lúc hiển thị, để giữ đúng ranh giới "System admin không đọc chi tiết
/// đơn hàng/khách hàng của tenant" (CLAUDE.md §7.9).
model EmailSendLog {
  id           String   @id @default(cuid(2))
  type         String
  recipient    String
  subject      String
  status       String
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("email_send_log")
}

/// Danh mục tài liệu — taxonomy CẤP PLATFORM do System Admin tạo trước
/// (/admin/categories), KHÔNG phải danh mục riêng của từng tenant. Sản phẩm
/// gắn qua `Product.categoryId` (ADR-026). Bảng L1 (không tenantId), không
/// cần RLS — cùng lớp với SystemBranding/Plan.
model DocumentCategory {
  id               String   @id @default(cuid(2))
  slug             String   @unique
  name             String
  shortDescription String?
  /// Rich text (HTML từ TiptapEditor, sanitize trước khi lưu — xem
  /// packages/core/src/content/sanitize-html.ts).
  description      String?
  imageUrl         String?
  seoTitle         String?
  seoDescription   String?
  /// Ảnh chia sẻ mạng xã hội — khuyến nghị 1200x630px.
  ogImageUrl       String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  products Product[]

  @@map("document_categories")
}

/// Nhận diện thương hiệu nền tảng (không phải branding riêng của từng
/// tenant — đó là `Tenant.branding`). Tất cả field đều nullable: null nghĩa
/// là "dùng mặc định" — brandName/brandSlogan rỗng thì `getEffectiveBrand()`
/// (apps/web/lib/branding.ts) rơi về `getBrand()` (env, §"packages/config").
/// Không đặt bảng này trong @gieochu/config vì package đó không được phép
/// phụ thuộc @gieochu/db (packages/db mới là bên phụ thuộc config, ngược lại
/// sẽ tạo circular dependency).
model SystemBranding {
  id                 String   @id @default("default")
  logoLightUrl       String?
  logoDarkUrl        String?
  logoSquareUrl      String?
  logoSidebarUrl     String?
  logoFooterUrl      String?
  faviconUrl         String?
  ogImageUrl         String?
  brandName          String?
  brandSlogan        String?
  primaryColorHex    String?
  accentColorHex     String?
  secondaryColorHex  String?
  navbarLogoHeightPx Int      @default(56)
  updatedAt          DateTime @updatedAt

  @@map("system_branding")
}

enum PaymentProviderId {
  MANUAL_QR
  SEPAY
  MOMO
}

/// §5.2 — TENANT_PAYMENT_CONFIGS. L2 (tenantId), RLS-protected like
/// products/tenant_members (packages/db/prisma/migrations/*_rls_m7/).
/// `encryptedSecrets` holds the AES-256-GCM ciphertext (packages/payments/src/encryption.ts);
/// plaintext secrets are never stored or returned to the client (§7.3).
model TenantPaymentConfig {
  id                String            @id @default(cuid(2))
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider          PaymentProviderId
  isEnabled         Boolean           @default(false)
  /// non-secret fields only (bank BIN, account no/name, partnerCode, environment...)
  publicConfig      Json
  encryptedSecrets  String
  webhookSecretHash String?
  lastVerifiedAt    DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@map("tenant_payment_configs")
}

/// §5.1 Layer System — platform_payment_configs. Same shape as
/// tenant_payment_configs but no tenantId (platform has exactly one config
/// per provider). Table created in M7; UI/business logic land in §"M3"
/// (apps/web/lib/platform-payment.ts) — saving auto-clears isEnabled/
/// lastVerifiedAt whenever the account/secret identity changes, so a config
/// never sits "enabled" with credentials nobody has re-confirmed.
model PlatformPaymentConfig {
  id                String            @id @default(cuid(2))
  provider          PaymentProviderId @unique
  isEnabled         Boolean           @default(false)
  publicConfig      Json
  encryptedSecrets  String
  webhookSecretHash String?
  lastVerifiedAt    DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("platform_payment_configs")
}

enum SubscriptionInvoiceStatus {
  PENDING
  PAID
  EXPIRED
  VOID
}

/// §"M3" — SUBSCRIPTION_INVOICES. L1 like Subscription/Plan (billing is
/// system-managed even though each row references one tenant) — not RLS
/// protected; access is gated in the application layer by
/// requireTenantMember (owner reading their own invoices) or requireRole
/// SYSTEM_ADMIN (admin reviewing pending manual-transfer invoices).
/// amountVnd/periodStart/periodEnd are snapshotted from the Plan at
/// creation time — a later price change never rewrites an issued invoice.
model SubscriptionInvoice {
  id              String                    @id @default(cuid(2))
  tenantId        String
  tenant          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId          String
  plan            Plan                      @relation(fields: [planId], references: [id])
  code            String                    @unique
  provider        PaymentProviderId
  status          SubscriptionInvoiceStatus @default(PENDING)
  amountVnd       Int
  periodStart     DateTime
  periodEnd       DateTime
  dueAt           DateTime
  paidAt          DateTime?
  /// CheckoutResult (packages/payments) captured once at creation — read
  /// back by the billing page instead of re-calling the provider (MoMo's
  /// createCheckout hits their API; QR providers are cheap to recompute but
  /// stored the same way for a uniform read path).
  checkoutPayload Json?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  transactions PlatformPaymentTransaction[]

  @@index([tenantId])
  @@map("subscription_invoices")
}

/// §"M3" — PLATFORM_PAYMENT_TRANSACTIONS. Every platform webhook event that
/// passed signature verification is recorded here, matched or not — the
/// sequence diagram's "Lệch số tiền hoặc không tìm thấy → lưu UNMATCHED để
/// admin xử lý" (matchedInvoiceId null = unmatched, admin reviews manually).
model PlatformPaymentTransaction {
  id               String               @id @default(cuid(2))
  provider         PaymentProviderId
  amountVnd        Int
  rawPayload       Json
  matchedInvoiceId String?
  matchedInvoice   SubscriptionInvoice? @relation(fields: [matchedInvoiceId], references: [id])
  createdAt        DateTime             @default(now())

  @@map("platform_payment_transactions")
}

enum WebhookScope {
  PLATFORM
  TENANT
}

/// §5.2 — webhook_events. Idempotency guard: a provider's event id must only
/// ever be processed once per scope+provider (§7.4). Written via
/// withSystemJob (no tenant session at the point a raw webhook arrives).
model WebhookEvent {
  id              String            @id @default(cuid(2))
  scope           WebhookScope
  provider        PaymentProviderId
  providerEventId String
  tenantId        String?
  receivedAt      DateTime          @default(now())

  @@unique([scope, provider, providerEventId])
  @@map("webhook_events")
}

/// §"M7": ngân hàng cho form chọn BIN khi cấu hình MANUAL_QR/SEPAY — seed từ
/// danh sách NAPAS/VietQR chính thức (packages/db/prisma/seed.ts).
model BankBin {
  bin       String @id
  name      String
  shortName String

  @@map("bank_bins")
}

enum CouponType {
  PERCENT
  FIXED
}

/// §"M6" — COUPONS. L2 (RLS like products/tenant_members). `productIds` is a
/// JSON array of Product ids (null/empty = applies to every product in the
/// tenant) — a plain array rather than a join table since it's small and
/// read as a unit by `calculatePrice()` (packages/core), never queried by
/// individual product id. `usedCount` is only ever incremented by M8's
/// order-PAID transition (`UPDATE ... WHERE usedCount < usageLimit`,
/// §"M6") — nothing in M6 itself writes it past the initial 0.
model Coupon {
  id               String     @id @default(cuid(2))
  tenantId         String
  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code             String
  type             CouponType
  value            Int
  maxDiscountVnd   Int?
  minOrderVnd      Int?
  usageLimit       Int?
  usedCount        Int        @default(0)
  perCustomerLimit Int?
  startsAt         DateTime?
  endsAt           DateTime?
  productIds       Json?
  isEnabled        Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  redemptions CouponRedemption[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("coupons")
}

/// §5.2 "Bảng phụ: coupon_redemptions (couponId, userId, orderId)". Written
/// once, atomically, by `markOrderPaid()` (§"M8") — `@@unique([couponId,
/// orderId])` makes a second attempt at the same order a no-op rather than
/// double-counting `usedCount`.
model CouponRedemption {
  id        String   @id @default(cuid(2))
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  tenantId  String
  userId    String
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([couponId, orderId])
  @@index([tenantId])
  @@map("coupon_redemptions")
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  EXPIRED
  CANCELED
  REFUNDED
}

/// §"M8" — ORDERS. L2 with an extra customer-ownership dimension: RLS
/// allows tenantId match (owner) OR customerId match under `app.scope =
/// 'customer'` (the buyer) OR system_job (§5.4) — see `_rls_m8`.
/// MVP is "mỗi đơn 1 sản phẩm" but `OrderItem` stays its own table (the
/// spec's own forward note) so a future cart just adds more rows.
model Order {
  id              String             @id @default(cuid(2))
  tenantId        String
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId      String
  customer        User               @relation(fields: [customerId], references: [id])
  code            String             @unique
  status          OrderStatus        @default(PENDING)
  subtotalVnd     Int
  discountVnd     Int                @default(0)
  totalVnd        Int
  couponCode      String?
  provider        PaymentProviderId?
  /// CheckoutResult (packages/payments) captured once the customer picks a
  /// provider on the checkout page — read back instead of re-calling the
  /// provider (MoMo's createCheckout hits their API), same as
  /// SubscriptionInvoice.checkoutPayload (M3).
  checkoutPayload Json?
  proofImageKey   String?
  /// Ghi chú bắt buộc khi owner xác nhận thủ công (§"M8"), cùng mẫu với
  /// SubscriptionInvoice.confirmNote (M3).
  confirmNote     String?
  expiresAt       DateTime
  paidAt          DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  items             OrderItem[]
  transactions      TenantPaymentTransaction[]
  couponRedemptions CouponRedemption[]

  @@index([tenantId])
  @@index([customerId])
  @@map("orders")
}

/// §5.3 "order_items lưu snapshot tiêu đề và giá tại thời điểm mua" — a later
/// price/title change on Product never rewrites a placed order.
model OrderItem {
  id            String   @id @default(cuid(2))
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  titleSnapshot String
  unitPriceVnd  Int
  finalPriceVnd Int
  createdAt     DateTime @default(now())

  entitlement Entitlement?
  reviews     Review[]

  @@index([orderId])
  @@map("order_items")
}

enum PaymentMatchStatus {
  MATCHED
  UNMATCHED
  MISMATCH_AMOUNT
}

/// §5.3 unique `(tenantId, provider, providerTxnId)` — the same provider
/// event id can never be recorded twice for a tenant (idempotency at the
/// ledger level, separate from `webhook_events`' idempotency at the HTTP
/// delivery level).
model TenantPaymentTransaction {
  id            String             @id @default(cuid(2))
  tenantId      String
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId       String?
  order         Order?             @relation(fields: [orderId], references: [id])
  provider      PaymentProviderId
  providerTxnId String
  amountVnd     Int
  matchStatus   PaymentMatchStatus
  rawPayload    Json
  createdAt     DateTime           @default(now())

  @@unique([tenantId, provider, providerTxnId])
  @@index([tenantId])
  @@map("tenant_payment_transactions")
}

/// §5.3 unique `(tenantId, userId)` — one aggregate row per customer per
/// tenant, upserted (cộng dồn) by `markOrderPaid()`.
model TenantCustomer {
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  ordersCount   Int       @default(0)
  totalSpentVnd Int       @default(0)
  firstOrderAt  DateTime?
  lastOrderAt   DateTime?
  note          String?

  @@id([tenantId, userId])
  @@index([tenantId])
  @@map("tenant_customers")
}

/// §5.2 Layer L3 "Customer" — filtered by userId (M9 downloads read this).
/// `downloadLimit` is a snapshot of `product.downloadLimit` at purchase
/// time (§5.3 snapshot convention) — a later change to the product's limit
/// never retroactively changes what an existing buyer already has.
model Entitlement {
  id            String    @id @default(cuid(2))
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  orderItemId   String    @unique
  orderItem     OrderItem @relation(fields: [orderItemId], references: [id])
  downloadsUsed Int       @default(0)
  downloadLimit Int
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  downloadTokens DownloadToken[]
  downloadEvents DownloadEvent[]

  @@index([userId])
  @@index([tenantId])
  @@map("entitlements")
}

/// §"M9" — single-use, 60s-TTL token bridging `POST /api/downloads` (creates
/// it) and `GET /api/downloads/{token}` (consumes it). Same shape as
/// RefreshToken/VerificationToken (hash stored, never the raw token) and,
/// like them, **L1 — no RLS**: the security boundary is "only the customer
/// who just requested it holds the raw token", not a tenant/user row filter,
/// so a plain `getPrismaClient()` lookup by `tokenHash` is correct here.
model DownloadToken {
  id            String      @id @default(cuid(2))
  tokenHash     String      @unique
  entitlementId String
  entitlement   Entitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  fileId        String
  file          ProductFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Denormalized from `entitlement.tenantId` at creation — lets `consumeDownloadToken()`
  /// open one `withTenant()` transaction immediately, without an extra RLS-scoped lookup
  /// just to learn which tenant scope to use.
  tenantId      String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime    @default(now())

  @@index([entitlementId])
  @@map("download_tokens")
}

/// §"M9" — L2, RLS: tenantId match (owner manages/reads stats) OR
/// app.scope='public' (anonymous `/s/{token}` lookup by tokenHash — the row
/// is readable even when revoked/expired so the app can tell "never
/// existed" (404) apart from "no longer usable" (410), same reasoning as
/// Order's customer-scope clause not filtering by status either).
/// `fileIds` null/empty = every file currently sold for the product
/// (same "empty = no restriction" convention as Coupon.productIds, M6).
model ShareLink {
  id           String    @id @default(cuid(2))
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  label        String
  passwordHash String?
  fileIds      Json?
  maxUses      Int?
  usedCount    Int       @default(0)
  expiresAt    DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  downloadEvents DownloadEvent[]

  @@index([tenantId])
  @@map("share_links")
}

/// §"M9" — L2, RLS by tenantId only (audit trail for the owner; no
/// customer-facing read of raw events, unlike Entitlement). Exactly one of
/// `entitlementId`/`shareLinkId` is set per row — a logged-in customer's own
/// download vs. an anonymous share-link download.
model DownloadEvent {
  id            String       @id @default(cuid(2))
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fileId        String
  file          ProductFile  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  entitlementId String?
  entitlement   Entitlement? @relation(fields: [entitlementId], references: [id])
  shareLinkId   String?
  shareLink     ShareLink?   @relation(fields: [shareLinkId], references: [id])
  userId        String?
  user          User?        @relation(fields: [userId], references: [id])
  ip            String?
  createdAt     DateTime     @default(now())

  @@index([tenantId])
  @@index([fileId])
  @@map("download_events")
}

enum StorefrontMessageStatus {
  NEW
  READ
  ARCHIVED
}

/// ADR-023: tin nhắn từ form liên hệ trên storefront `/[tenantSlug]` — bảng L2 có RLS
/// (migration `rls_storefront_messages`): scope public chỉ INSERT, scope tenant
/// SELECT/UPDATE/DELETE đúng tenantId. System admin không có đường đọc (§7.9).
/// Không lưu IP thô — `ipHash` = HMAC-SHA256(ip), chỉ dùng cho rate limit.
model StorefrontMessage {
  id        String                  @id @default(cuid(2))
  tenantId  String
  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  email     String
  message   String
  status    StorefrontMessageStatus @default(NEW)
  ipHash    String?
  createdAt DateTime                @default(now())

  @@index([tenantId, createdAt])
  @@index([ipHash, createdAt])
  @@map("storefront_messages")
}

enum TenantMediaUsage {
  CONTENT
  PRODUCT_COVER
  STOREFRONT
  /// ADR-029 mục 5 (M10b): ảnh trong nội dung bài viết (folder `tenants/<id>/posts`).
  POST
}

/// ADR-028: ghi nhận ảnh tenant đã upload lên Cloudinary HỆ THỐNG để tính hạn mức `Plan.imageStorageMb`.
/// Bảng L2 có RLS (migration `rls_adr028_media_assets`, policy `tenant_isolation`: đúng tenantId hoặc scope
/// system_job cho job dọn asset sau này). Dòng được tạo khi CẤP CHỮ KÝ (giữ chỗ, `bytes` tạm tính,
/// `verifiedAt = null`) và cập nhật số thật khi server đọc Cloudinary Admin API (`verifiedAt` có giá trị) —
/// không bao giờ lấy `bytes` từ client. `publicId` do server sinh (nằm trong chữ ký upload).
model TenantMediaAsset {
  id         String           @id @default(cuid(2))
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  publicId   String           @unique
  bytes      Int
  format     String?
  width      Int?
  height     Int?
  usage      TenantMediaUsage
  /// null = mới giữ chỗ lúc ký, chưa xác minh với Cloudinary (bytes là mức tạm tính).
  verifiedAt DateTime?
  createdAt  DateTime         @default(now())

  @@index([tenantId, createdAt])
  @@map("tenant_media_assets")
}

enum ReviewStatus {
  VISIBLE
  HIDDEN
}

/// ADR-029 mục 2. `REFUNDED` chỉ do hệ thống đặt (hoàn tiền / thu hồi entitlement) — tenant không chọn được.
enum ReviewHiddenReason {
  SPAM
  OFFENSIVE
  IRRELEVANT
  PERSONAL_INFO
  REFUNDED
  OTHER
}

/// ADR-029 (M10a) — đánh giá sản phẩm. Bảng L2 có RLS tách theo lệnh (migration `rls_m10a_reviews`):
/// public đọc VISIBLE của sản phẩm PUBLISHED; customer đọc/ghi/xoá của chính mình (INSERT/UPDATE phải còn đơn
/// FULFILLED + entitlement chưa thu hồi); tenant đọc/UPDATE (ẩn, khôi phục, trả lời) của tenant mình; system_job.
/// Không nhánh admin (§7.9). Trigger `reviews_guard_columns` chặn customer đổi cột kiểm duyệt/trả lời và chặn
/// tenant đổi nội dung của khách. `orderItemId` = dòng đơn chứng minh quyền đánh giá (cập nhật khi khách mua lại
/// rồi sửa). `displayName` là snapshot tên rút gọn ("Minh A.") lúc ghi — trang public không join hồ sơ L1.
model Review {
  id           String              @id @default(cuid(2))
  tenantId     String
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId    String
  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItemId  String
  orderItem    OrderItem           @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  /// 1–5 (CHECK `reviews_rating_range`).
  rating       Int
  /// Văn bản thuần ≤2000 ký tự (CHECK), null = chỉ chấm sao.
  body         String?
  displayName  String
  status       ReviewStatus        @default(VISIBLE)
  /// Có giá trị ⇔ status = HIDDEN (CHECK `reviews_hidden_shape`).
  hiddenReason ReviewHiddenReason?
  hiddenAt     DateTime?
  /// Trả lời của người bán (1 trả lời/đánh giá, sửa được), văn bản thuần ≤2000 ký tự.
  reply        String?
  repliedAt    DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([productId, userId])
  @@index([tenantId, createdAt])
  @@index([productId, status, createdAt])
  @@index([userId])
  @@index([orderItemId])
  @@map("reviews")
}

/// ADR-029 mục 5: tenant tự chuyển DRAFT ⇄ PUBLISHED; `HIDDEN` chỉ dành cho gỡ do vi phạm (M12) — tenant không đặt
/// được và không tự gỡ được (trigger `posts_guard_columns`).
enum PostStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

/// ADR-029 mục 5–6 (M10b) — bài viết tối giản của tenant. Bảng L2 có RLS tách theo lệnh (migration `rls_m10b_posts`):
/// public chỉ đọc PUBLISHED của tenant không LOCKED; tenant đọc/ghi/xoá bài của mình; system_job. Không nhánh
/// customer/admin (§7.9). `body` là HTML đã qua `sanitizeRichTextHtml` (ảnh chỉ Cloudinary hệ thống, ≤6 ảnh — kiểm
/// ở server). `excerpt` là văn bản thuần tự sinh từ `body` (≤300 ký tự). `productId` phải là sản phẩm CÙNG tenant
/// (trigger `posts_guard_product_tenant`); xoá sản phẩm → SetNull. Tối đa 1 bài ghim/tenant: partial unique index
/// `posts_tenantId_pinned_key` (`WHERE "isPinned"`, khai báo trong migration SQL — Prisma không biểu diễn được).
model Post {
  id           String     @id @default(cuid(2))
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Tuỳ chọn, ≤200 ký tự (CHECK `posts_title_length`).
  title        String?
  body         String
  /// Văn bản thuần ≤300 ký tự sinh từ `body` khi lưu; "" khi bài chỉ có ảnh.
  excerpt      String     @default("")
  productId    String?
  product      Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  status       PostStatus @default(DRAFT)
  /// Chỉ có giá trị khi status = HIDDEN (M12 đặt, qua system_job).
  hiddenReason String?
  isPinned     Boolean    @default(false)
  /// Lần xuất bản đầu tiên (giữ nguyên khi gỡ về DRAFT rồi đăng lại). Bắt buộc khi PUBLISHED (CHECK).
  publishedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([tenantId, status, publishedAt(sort: Desc)])
  @@index([productId])
  @@map("posts")
}
