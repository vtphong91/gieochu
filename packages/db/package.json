{
  "name": "@gieochu/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "echo \"no unit tests in @gieochu/db (RLS/query tests run as Vitest integration tests in apps/web)\"",
    "test:integration": "echo \"no integration tests in @gieochu/db\"",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@gieochu/config": "workspace:*",
    "@prisma/adapter-neon": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
