# ADR-032 / ADR-037: env runtime CHỈ còn hạ tầng + secret — 8 cấu hình bắt buộc + NODE_ENV do nền tảng đặt.
# Thương hiệu (tên/slogan/logo) cấu hình ở System Center › Nhận diện thương hiệu (/admin/settings/branding);
# thời hạn token/link/presign, dùng thử, ân hạn, đơn/hoá đơn chờ, lượt tải mặc định ở System Center › Cấu hình chung (/admin/settings/general).
# Múi giờ hiển thị là hằng Asia/Ho_Chi_Minh trong code. Các biến APP_NAME, ACCESS_TOKEN_TTL, TRIAL_DAYS... cũ không còn được đọc.

# -----------------------------------------------------------------------------
# 1. App Configuration (Chia nhỏ theo ADR-037)
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_HOST=localhost
APP_PORT=3000
APP_PROTOCOL=http
# (Hoặc dùng chuỗi URL hoàn chỉnh: APP_URL=http://localhost:3000)

# -----------------------------------------------------------------------------
# 2. Database Configuration (Chia nhỏ theo ADR-037)
# -----------------------------------------------------------------------------
# Direct host (IP / domain kết nối trực tiếp, dùng cho pg-boss và prisma migrate)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gieochu
DB_SSLMODE=disable                     # 'require' trên cloud (Neon), 'disable' khi chạy local

# Tài khoản ứng dụng (Runtime: Next.js & Background Jobs, role gieochu_app không có BYPASSRLS - xem ADR-010)
DB_USER=gieochu_app
DB_PASSWORD=your_app_password_here

# Tài khoản Migration / DDL (Chỉ dùng cho dev/CI để chạy prisma migrate / setup-app-role - CẤM đưa lên Vercel)
DB_MIGRATE_USER=postgres
DB_MIGRATE_PASSWORD=your_owner_password_here

# (Tuỳ chọn) Nếu dùng Neon cloud, hệ thống tự động suy luận host pooler thêm '-pooler'.
# Nếu dùng PgBouncer riêng biệt, bạn có thể chỉ định rõ:
# DB_POOLED_HOST=ep-xxx-pooler.region.aws.neon.tech
# DB_POOLED_PORT=5432

# --- Tuỳ chọn thay thế: Sử dụng chuỗi URL hoàn chỉnh (Hệ thống vẫn tương thích ngược) ---
# DATABASE_URL="postgresql://gieochu_app:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# DIRECT_URL="postgresql://gieochu_app:PASSWORD@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require"
# PRISMA_MIGRATE_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require"
# TEST_DATABASE_URL=

# -----------------------------------------------------------------------------
# 3. Auth & JWT
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long   # [RUNTIME] >= 32 ký tự
JWT_ISSUER=gieochu                                                # [RUNTIME]
JWT_AUDIENCE=gieochu-web                                          # [RUNTIME]

# -----------------------------------------------------------------------------
# 4. Encryption Keys
# -----------------------------------------------------------------------------
PAYMENT_ENCRYPTION_KEY=your_payment_encryption_key_32_bytes_base64  # [RUNTIME] 32 bytes base64
STORAGE_ENCRYPTION_KEY=your_storage_encryption_key_32_bytes_base64  # [RUNTIME] 32 bytes base64 (ADR-017)

# -----------------------------------------------------------------------------
# 5. Background Cron (ADR-036 - Tuỳ chọn)
# -----------------------------------------------------------------------------
# Vercel Cron gọi GET /api/cron/daily kèm header "Authorization: Bearer <CRON_SECRET>".
# Không đặt → route trả 503 (job sweep hằng ngày không chạy), app vẫn khởi động bình thường.
# Nếu đặt, bắt buộc phải >= 32 ký tự.
CRON_SECRET=

# -----------------------------------------------------------------------------
# 6. Storage & Anti-virus (Tuỳ chọn)
# -----------------------------------------------------------------------------
# S3 / Cloudflare R2 được cấu hình qua giao diện System Admin (/admin/settings/storage).
CLAMAV_HOST=

# -----------------------------------------------------------------------------
# 7. Email Fallback (Chỉ dành cho local dev / Mailpit)
# -----------------------------------------------------------------------------
# Production cấu hình trực tiếp trong System Center (/admin/settings/smtp, bảng SystemSmtpConfig).
EMAIL_PROVIDER=smtp                                               # smtp | resend
EMAIL_FROM="Gieo Chữ <no-reply@gieochu.net>"
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# 8. Seed & Sandbox (Chỉ dành cho dev)
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
MOMO_SANDBOX_ENDPOINT=
