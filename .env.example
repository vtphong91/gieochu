# ADR-032: env runtime CHỈ còn hạ tầng + secret — 8 biến bắt buộc (đánh dấu [RUNTIME]) + NODE_ENV do
# nền tảng đặt. Thương hiệu (tên/slogan/logo) cấu hình ở System Center › Nhận diện thương hiệu
# (/admin/settings/branding); thời hạn token/link/presign, dùng thử, ân hạn, đơn/hoá đơn chờ, lượt tải
# mặc định ở System Center › Cấu hình chung (/admin/settings/general). Múi giờ hiển thị là hằng
# Asia/Ho_Chi_Minh trong code. Các biến APP_NAME, ACCESS_TOKEN_TTL, TRIAL_DAYS... cũ không còn được đọc.

# App
NODE_ENV=development
APP_URL=http://localhost:3000          # [RUNTIME] production: https://gieochu.net

# Database (Neon). DATABASE_URL/DIRECT_URL use the restricted "gieochu_app"
# role (no BYPASSRLS — see docs/DECISIONS.md ADR-010), created by
# packages/db/scripts/setup-app-role.mts. PRISMA_MIGRATE_URL uses the Neon
# owner role (from Neon Console) and is only for `prisma migrate`/`studio` and
# setup-app-role.mts (`prisma generate` and `db seed` do not need it).
# CHỈ đặt trên máy dev/CI chạy migration — KHÔNG đặt trên Vercel/runtime
# (app không đọc biến này; lộ nó = lộ role owner có BYPASSRLS).
DATABASE_URL="postgresql://gieochu_app:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require"   # [RUNTIME]
DIRECT_URL="postgresql://gieochu_app:PASSWORD@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require"            # [RUNTIME]
PRISMA_MIGRATE_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require"
TEST_DATABASE_URL=

# Auth
JWT_ACCESS_SECRET=           # [RUNTIME] >= 32 bytes
JWT_ISSUER=gieochu           # [RUNTIME]
JWT_AUDIENCE=gieochu-web     # [RUNTIME]

# Encryption
PAYMENT_ENCRYPTION_KEY=      # [RUNTIME] 32 bytes base64
STORAGE_ENCRYPTION_KEY=      # [RUNTIME] 32 bytes base64 — separate key from PAYMENT_ENCRYPTION_KEY (ADR-017)

# Cron (ADR-036) — tuỳ chọn. Vercel Cron gọi GET /api/cron/daily kèm "Authorization: Bearer <CRON_SECRET>".
# Không đặt → route trả 503 (sweep thuê bao/đơn và dọn hàng đợi hằng ngày không chạy), app vẫn khởi động.
# >= 32 ký tự ngẫu nhiên, vd: openssl rand -hex 32. Đặt trên Vercel (Production) — không commit giá trị thật.
CRON_SECRET=

# Storage (S3 compatible) — endpoint/region/buckets/access keys are configured
# via System Admin (/admin/settings/storage), not env vars (ADR-017).
# Tuỳ chọn: chưa có client ClamAV thật — đặt hay không đều chỉ log cảnh báo (apps/web/lib/file-scan.ts).
CLAMAV_HOST=

# Email — CHỈ fallback cho dev (Mailpit); production cấu hình ở System Center
# (/admin/settings/smtp) — KHÔNG cần đặt các biến dưới đây trên Vercel/runtime.
# Cấu hình SMTP ở System Center (bật + đã xác minh) luôn được ưu tiên. Env chỉ
# dùng khi đủ SMTP_HOST + SMTP_PORT + EMAIL_FROM (hoặc EMAIL_PROVIDER=resend +
# RESEND_API_KEY + EMAIL_FROM). Thiếu cả hai nguồn: app vẫn chạy, việc gửi email
# báo lỗi EMAIL_NOT_CONFIGURED.
EMAIL_PROVIDER=smtp          # smtp | resend
EMAIL_FROM="Gieo Chữ <no-reply@gieochu.net>"
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=

# Seed (chỉ dùng khi chạy `pnpm db:seed` để tạo super admin đầu tiên — không
# set thì seed.ts bỏ qua bước này, không tạo tài khoản demo nào)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Payment sandbox (chỉ dùng cho dev/test)
MOMO_SANDBOX_ENDPOINT=

# Dữ liệu demo — CHỈ dev (apps/web/scripts/demo-reviews.ts, runbook Dev-Demo-Data-Runbook).
# Không đặt các biến này ở staging/production; script tự từ chối nếu NODE_ENV=production hoặc APP_URL không phải localhost.
# ALLOW_DEMO_SEED=1
# DEMO_SEED_BLOCKED_DB_HOSTS=   # danh sách host DB cấm seed, cách nhau bằng dấu phẩy

# Seed (tuỳ chọn) — email hỗ trợ ghi vào system_settings khi chạy pnpm db:seed.
# SEED_SUPPORT_EMAIL=
