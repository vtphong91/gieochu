# App
NODE_ENV=development
APP_URL=http://localhost:3000          # production: https://gieochu.net
APP_NAME="Gieo Chữ"
APP_SHORT_NAME="Gieo"
APP_SLOGAN="Gieo kiến thức. Tạo giá trị."
TZ_DISPLAY=Asia/Ho_Chi_Minh

# Database (Neon). DATABASE_URL/DIRECT_URL use the restricted "gieochu_app"
# role (no BYPASSRLS — see docs/DECISIONS.md ADR-010), created by
# packages/db/scripts/setup-app-role.mts. PRISMA_MIGRATE_URL uses the Neon
# owner role (from Neon Console) and is only for `prisma migrate`/`generate`.
DATABASE_URL="postgresql://gieochu_app:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://gieochu_app:PASSWORD@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require"
PRISMA_MIGRATE_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require"
TEST_DATABASE_URL=

# Auth
JWT_ACCESS_SECRET=           # >= 32 bytes
JWT_ISSUER=gieochu
JWT_AUDIENCE=gieochu-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# Encryption
PAYMENT_ENCRYPTION_KEY=      # 32 bytes base64
STORAGE_ENCRYPTION_KEY=      # 32 bytes base64 — separate key from PAYMENT_ENCRYPTION_KEY (ADR-017)

# Storage (S3 compatible) — endpoint/region/buckets/access keys are configured
# via System Admin (/admin/settings/storage), not env vars (ADR-017). These
# are just operational parameters that stay in env.
PRESIGN_UPLOAD_TTL_SECONDS=600
PRESIGN_DOWNLOAD_TTL_SECONDS=600
CLAMAV_HOST=

# Email
EMAIL_PROVIDER=smtp          # smtp | resend
EMAIL_FROM="Gieo Chữ <no-reply@gieochu.net>"
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=

# Seed (chỉ dùng khi chạy `pnpm db:seed` để tạo super admin đầu tiên — không
# set thì seed.ts bỏ qua bước này, không tạo tài khoản demo nào)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Business
TRIAL_DAYS=14
GRACE_DAYS=7
ORDER_PENDING_TTL_MINUTES=60
INVOICE_PENDING_TTL_HOURS=24
DEFAULT_DOWNLOAD_LIMIT=5

# Payment sandbox (chỉ dùng cho dev/test)
MOMO_SANDBOX_ENDPOINT=
